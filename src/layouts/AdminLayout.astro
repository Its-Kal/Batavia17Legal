---
interface Props {
  title: string;
  activeMenu: 'statistik' | 'content' | 'users';
  userRole: 'admin_utama' | 'staff';
  userEmail: string;
}

const { title, activeMenu, userRole, userEmail } = Astro.props;
const initials = userEmail.slice(0, 2).toUpperCase();
---
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/images/favicon1.svg" />
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>* { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-slate-100">

<div class="flex h-screen overflow-hidden">

  {/* Sidebar */}
  <aside class="w-64 bg-[#0A1931] text-white flex flex-col flex-shrink-0">
    {/* Logo */}
    <div class="px-6 py-5 border-b border-white/10">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-[#D4AF37] text-[#0A1931] flex items-center justify-center font-bold text-sm">B17</div>
        <div>
          <div class="font-bold text-sm leading-tight">Batavia 17</div>
          <div class="text-white/40 text-xs">Admin Panel</div>
        </div>
      </div>
    </div>

    {/* Nav */}
    <nav class="flex-1 px-3 py-4 space-y-1">
      {userRole === 'admin_utama' && (
        <>
          <a href="/admin" class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${activeMenu === 'statistik' ? 'bg-[#D4AF37] text-[#0A1931]' : 'text-white/70 hover:bg-white/10 hover:text-white'}`}>
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
            Statistik
          </a>
          <a href="/admin/content" class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${activeMenu === 'content' ? 'bg-[#D4AF37] text-[#0A1931]' : 'text-white/70 hover:bg-white/10 hover:text-white'}`}>
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            Content
          </a>
          <a href="/admin/users" class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${activeMenu === 'users' ? 'bg-[#D4AF37] text-[#0A1931]' : 'text-white/70 hover:bg-white/10 hover:text-white'}`}>
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            Kelola User
          </a>
        </>
      )}
    </nav>

    {/* User info + logout */}
    <div class="px-3 py-4 border-t border-white/10">
      <div class="flex items-center gap-3 mb-3 px-3">
        <div class="w-8 h-8 rounded-full bg-[#D4AF37] text-[#0A1931] flex items-center justify-center font-bold text-xs flex-shrink-0">
          {initials}
        </div>
        <div class="min-w-0">
          <div class="text-xs font-medium truncate">{userEmail}</div>
          <div class="text-white/40 text-[10px] uppercase tracking-wider">
            {userRole === 'admin_utama' ? 'Admin Utama' : 'Staff'}
          </div>
        </div>
      </div>
      <button id="logout-btn" class="w-full flex items-center gap-2 px-3 py-2 text-white/50 hover:text-white hover:bg-white/10 rounded-lg text-xs transition-colors">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Logout
      </button>
    </div>
  </aside>

  {/* Main content */}
  <main class="flex-1 overflow-y-auto">
    <slot />
  </main>
</div>

<script>
  import { createClient } from '@supabase/supabase-js';
  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );
  document.getElementById('logout-btn')?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.href = '/admin/login?success=logout';
  });
</script>

</body>
</html>
