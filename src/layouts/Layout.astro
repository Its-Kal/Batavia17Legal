---
export interface Props {
  title?: string;
  description?: string;
  isDarkHeader?: boolean;
}

const {
  title = 'Batavia 17 — Konsultan Bantuan Hukum',
  description = 'Konsultan bantuan hukum profesional untuk individu dan korporasi. Layanan hukum pidana, perdata, bisnis, keluarga, pertanahan, dan ketenagakerjaan.',
  isDarkHeader = true,
} = Astro.props;

import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FloatingRatingButton from '../components/WhatsAppFab.astro';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/images/favicon1.svg" />
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="bg-surface-light font-sans text-text-dark antialiased selection:bg-gold-accent selection:text-white overflow-x-hidden">
    <Navbar isDark={isDarkHeader} />
    <main class="w-full">
      <slot />
    </main>
    <Footer />
    <FloatingRatingButton />

    {/* Testimonial Modal */}
    <div id="testimonial-modal" class="hidden fixed inset-0 z-[200] flex items-center justify-center bg-black/50 p-4">
      <div class="bg-white rounded-2xl w-full max-w-md shadow-2xl overflow-hidden">
        <div class="bg-[#0A1931] text-white px-6 py-4 flex items-center justify-between">
          <div>
            <h3 class="font-bold text-base">Beri Penilaian</h3>
            <p class="text-white/60 text-xs mt-0.5">Ceritakan pengalaman silaturahmi Anda</p>
          </div>
          <button id="close-testimonial-modal" class="text-white/60 hover:text-white transition-colors">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
        <form id="testimonial-form" class="p-6 space-y-4">
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1.5">Nama Lengkap *</label>
            <input type="text" name="name" required placeholder="Nama Anda" class="w-full border border-slate-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#0A1931]/30 focus:border-[#0A1931]/40" />
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1.5">Perusahaan (opsional)</label>
              <input type="text" name="company" placeholder="Nama perusahaan" class="w-full border border-slate-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#0A1931]/30 focus:border-[#0A1931]/40" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1.5">Kota (opsional)</label>
              <input type="text" name="location" placeholder="Contoh: Jakarta" class="w-full border border-slate-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#0A1931]/30 focus:border-[#0A1931]/40" />
            </div>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1.5">Rating *</label>
            <div id="star-rating" class="flex gap-1">
              {[1,2,3,4,5].map(n => (
                <button type="button" class="star-btn text-2xl text-slate-300 hover:text-amber-500 transition-colors" data-value={n}>★</button>
              ))}
            </div>
            <input type="hidden" name="rating" id="rating-input" value="5" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1.5">Ceritakan Pengalaman Anda *</label>
            <textarea name="content" required rows="4" placeholder="Bagaimana Batavia 17 membantu menyelesaikan masalah hukum Anda?" class="w-full border border-slate-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#0A1931]/30 focus:border-[#0A1931]/40 resize-none"></textarea>
          </div>
          <div id="testimonial-status" class="hidden text-sm text-center py-2 rounded-lg"></div>
          <button type="submit" class="w-full bg-[#0A1931] hover:bg-[#1a3a5c] text-white font-semibold text-sm py-3 rounded-xl transition-colors">Kirim Penilaian</button>
          <p class="text-center text-xs text-slate-400">Penilaian Anda akan ditampilkan setelah disetujui admin.</p>
        </form>
      </div>
    </div>

    <script>
      document.body.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement).closest('a[href*="wa.me"]');
        if (!link) return;
        const url = (link as HTMLAnchorElement).href;
        fetch('/api/track-whatsapp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            url: window.location.pathname,
            referrer: document.referrer,
          }),
        }).catch(() => {});
      });

      // Testimonial modal
      document.getElementById('close-testimonial-modal')?.addEventListener('click', () => {
        document.getElementById('testimonial-modal')?.classList.add('hidden');
      });
      document.getElementById('testimonial-modal')?.addEventListener('click', (e) => {
        if (e.target === e.currentTarget) {
          (e.currentTarget as HTMLElement).classList.add('hidden');
        }
      });

      // Star rating
      const starBtns = document.querySelectorAll('.star-btn');
      const ratingInput = document.getElementById('rating-input') as HTMLInputElement;
      let selectedRating = 5;
      function renderStars(val: number) {
        starBtns.forEach((btn, i) => {
          const el = btn as HTMLElement;
          el.classList.toggle('text-amber-500', i < val);
          el.classList.toggle('text-slate-300', i >= val);
        });
      }
      renderStars(selectedRating);
      starBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          selectedRating = parseInt((btn as HTMLElement).dataset.value ?? '5');
          ratingInput.value = String(selectedRating);
          renderStars(selectedRating);
        });
      });

      // Submit
      document.getElementById('testimonial-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = e.target as HTMLFormElement;
        const fd = new FormData(form);
        const status = document.getElementById('testimonial-status')!;
        const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;

        btn.disabled = true;
        btn.textContent = 'Mengirim...';

        // Inline Supabase client (no module import in non-module script)
        const supabaseUrl = (window as any).SUPABASE_URL ?? import.meta.env.PUBLIC_SUPABASE_URL;
        const supabaseKey = (window as any).SUPABASE_ANON_KEY ?? import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
        const { createClient } = await import('https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm');
        const sb = createClient(supabaseUrl, supabaseKey);

        const { error } = await sb.from('testimonials').insert({
          name: fd.get('name') as string,
          company: (fd.get('company') as string) || null,
          location: (fd.get('location') as string) || null,
          content: fd.get('content') as string,
          rating: selectedRating,
        });

        if (error) {
          status.className = 'text-sm text-center py-2 rounded-lg bg-red-50 text-red-600';
          status.textContent = '✗ Gagal mengirim: ' + error.message;
        } else {
          status.className = 'text-sm text-center py-2 rounded-lg bg-green-50 text-green-700';
          status.textContent = '✓ Terima kasih! Penilaian Anda sedang menunggu persetujuan.';
          form.reset();
          selectedRating = 5;
          renderStars(5);
          setTimeout(() => {
            document.getElementById('testimonial-modal')?.classList.add('hidden');
            status.classList.add('hidden');
          }, 2500);
        }
        status.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = 'Kirim Penilaian';
      });
    </script>
  </body>
</html>

<style is:global>
  .material-symbols-outlined {
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    font-family: 'Material Symbols Outlined';
    font-weight: normal;
    font-style: normal;
    line-height: 1;
    letter-spacing: normal;
    text-transform: none;
    display: inline-block;
    white-space: nowrap;
    word-wrap: normal;
    direction: ltr;
  }
  ::-webkit-scrollbar { display: none; }
</style>
