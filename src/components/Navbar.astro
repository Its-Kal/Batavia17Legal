---
import { supabase } from '../utils/supabase';

export const prerender = false;

// Fetch contact info (WhatsApp number) from Supabase
const { data: contactSection } = await supabase
  .from('landing_sections')
  .select('extra')
  .eq('section_key', 'contact')
  .single();

const whatsappNumber = contactSection?.extra?.whatsapp ?? '6285828331717';
const whatsappDisplay = contactSection?.extra?.whatsapp_display ?? '085828331717';
const whatsappMsg = 'Halo Admin Batavia 17, saya butuh pendampingan untuk masalah tagihan pinjaman online / kartu kredit.';
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMsg)}`;

const navLinks = [
  { href: '/', label: 'Beranda' },
  { href: '/berita', label: 'Berita & Edukasi' },
  { href: '/tentang', label: 'Tentang Kami' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

const logoUrl = '/images/logo.webp';

const marqueeText = 'Batavia 17 bukan pemberi pinjaman, tetapi pendampingan dalam proses tagihan pinjaman online ataupun kartu kredit';
---

<!-- ======================================================== -->
<!-- TOP MARQUEE STRIP — full width scrolling disclaimer    -->
<!-- ======================================================== -->
<div class="bg-[#061124] border-b border-[#162847]/60 overflow-hidden w-full">
  <div class="running-marquee-outer relative overflow-hidden">
    <div class="running-marquee-inner flex items-center whitespace-nowrap">
      <span class="running-marquee-content text-[11px] sm:text-[12px] text-amber-400/90 font-medium tracking-wide py-1.5 px-4">
        &nbsp;•&nbsp; {marqueeText} &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
      </span>
      <span class="running-marquee-content text-[11px] sm:text-[12px] text-amber-400/90 font-medium tracking-wide py-1.5 px-4" aria-hidden="true">
        &nbsp;•&nbsp; {marqueeText} &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
      </span>
      <span class="running-marquee-content text-[11px] sm:text-[12px] text-amber-400/90 font-medium tracking-wide py-1.5 px-4" aria-hidden="true">
        &nbsp;•&nbsp; {marqueeText} &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
      </span>
    </div>
  </div>
</div>

<!-- ======================================================== -->
<!-- MAIN NAVBAR                                             -->
<!-- ======================================================== -->
<header class="sticky top-0 z-[99] bg-[#061124]/95 backdrop-blur-md border-b border-[#162847]/60 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 h-16 sm:h-20 lg:h-24 flex items-center justify-between">

    {/* Logo */}
    <a class="flex items-center gap-2 sm:gap-3 group" href="/">
      <div class="w-10 h-10 sm:w-12 sm:h-12 lg:w-16 lg:h-16 rounded-full overflow-hidden ring-2 ring-gold-accent/40 shadow-gold-glow flex-shrink-0">
        <img alt="Batavia 17 Logo" class="w-full h-full object-cover object-center transition-transform group-hover:scale-105" src={logoUrl} />
      </div>
      <div class="flex flex-col leading-none">
        <span class="font-display font-bold text-white text-sm sm:text-base lg:text-xl tracking-wide group-hover:text-gold-light transition-colors">BATAVIA 17</span>
        <span class="font-display font-semibold text-[8px] sm:text-[10px] lg:text-[11px] text-gold-light tracking-[0.1em] sm:tracking-[0.15em] lg:tracking-[0.18em] uppercase mt-0.5 sm:mt-1 hidden sm:block">Konsultan Pinjaman Online & Kartu Kredit</span>
      </div>
    </a>

    {/* Desktop Navigation */}
    <nav class="hidden lg:flex items-center gap-10">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`font-medium text-[15px] transition-colors relative py-2 ${
            isActive(link.href)
              ? 'text-gold-light after:absolute after:bottom-0 after:left-0 after:right-0 after:h-0.5 after:bg-gold-accent'
              : 'text-white hover:text-gold-light'
          }`}
        >
          {link.label}
        </a>
      ))}
    </nav>

    {/* Desktop CTA Button */}
    <a
      class="hidden lg:inline-flex items-center justify-center gap-2.5 bg-[#D32F2F] hover:bg-[#B71C1C] text-white text-[15px] font-semibold px-6 py-3 rounded-lg shadow-[0_6px_20px_rgba(211,47,47,0.4)] transition-all transform hover:-translate-y-0.5 active:translate-y-0"
      href={whatsappUrl}
      rel="noopener noreferrer"
      target="_blank"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      Hubungi Batavia 17
    </a>

    {/* Mobile Menu Button */}
    <button id="mobile-menu-btn" class="lg:hidden flex items-center justify-center w-10 h-10 rounded-lg bg-[#162847]/50 text-white hover:bg-[#162847] transition-colors" onclick="toggleMobileMenu()">
      <svg id="menu-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
      <svg id="close-icon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  {/* Mobile Menu */}
  <div id="mobile-menu" class="lg:hidden hidden bg-[#061124]/98 backdrop-blur-md border-t border-[#162847]/60 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col gap-2">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`font-medium text-base py-3 px-4 rounded-lg transition-colors ${
            isActive(link.href)
              ? 'text-gold-light bg-[#162847]/50'
              : 'text-white hover:bg-[#162847]/50'
          }`}
        >
          {link.label}
        </a>
      ))}
      <a
        class="flex items-center justify-center gap-2 bg-[#D32F2F] hover:bg-[#B71C1C] text-white font-semibold py-3 rounded-lg mt-2 transition-colors"
        href={whatsappUrl}
        rel="noopener noreferrer"
        target="_blank"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Hubungi via WhatsApp
      </a>
    </div>
  </div>
</header>

<style>
  /* Marquee animation */
  .running-marquee-outer {
    height: 30px;
    overflow: hidden;
  }
  .running-marquee-inner {
    display: flex;
    align-items: center;
    height: 100%;
    width: max-content;
    animation: marqueeScroll 35s linear infinite;
  }
  .running-marquee-inner:hover {
    animation-play-state: paused;
  }
  .running-marquee-content {
    flex-shrink: 0;
  }
  @keyframes marqueeScroll {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-33.333%); }
  }
</style>

<script is:inline>
  function toggleMobileMenu() {
    const menu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');
    if (!menu || !menuIcon || !closeIcon) return;
    if (menu.classList.contains('hidden')) {
      menu.classList.remove('hidden');
      menuIcon.classList.add('hidden');
      closeIcon.classList.remove('hidden');
    } else {
      menu.classList.add('hidden');
      menuIcon.classList.remove('hidden');
      closeIcon.classList.add('hidden');
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    const menuLinks = document.querySelectorAll('#mobile-menu a');
    menuLinks.forEach(link => {
      link.addEventListener('click', function() {
        const menu = document.getElementById('mobile-menu');
        const menuIcon = document.getElementById('menu-icon');
        const closeIcon = document.getElementById('close-icon');
        if (!menu || !menuIcon || !closeIcon) return;
        menu.classList.add('hidden');
        menuIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      });
    });
  });
</script>
