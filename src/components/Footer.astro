---
const year = new Date().getFullYear();
const whatsappUrl = `https://wa.me/6285706129641?text=${encodeURIComponent('Halo Admin Batavia 17, saya butuh arah hukum.')}`;
const logoUrl = 'https://lh3.googleusercontent.com/aida-public/AB6AXuBuIfYd4CxD2KdgLpMgCAFjy_bG48gmOTv7boFeDa6jZRtchMHyK801NsbNmdgL1UMJLk9n0VR-FtJtgffqtfvi2uXQOqgMVt3X91IU8uF7hlghPKGI5uiF7gQhollYT9WTPMTIBwNo6nEZoHJrsO2G_3Qgo1xrpcKIe0krTqH8bRCbVWYvss9GGTzESEjfBCSfvqvodYShXrl6beybgARhiZ86UTsoeLF-tcAh3UjvW6GDQ0HMu5A4WmEUXDjc4PXFdQ';
---

<footer class="bg-[#050D1D] text-slate-400 border-t border-navy-border/60 pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-navy-border/50">
      <div class="md:col-span-6 flex flex-col items-start gap-4">
        <div class="flex items-center gap-3">
          <img alt="Batavia 17 Logo" class="w-36 h-36 rounded-full object-cover ring-2 ring-gold-accent/40" src={logoUrl} />
          <span class="font-display font-bold text-white text-2xl tracking-wide">BATAVIA 17</span>
        </div>
        <p class="text-sm text-slate-400 max-w-md leading-relaxed">
          Konsultan bantuan hukum — pendampingan yang berangkat dari kejelasan dan kepedulian.
        </p>
        <div class="flex items-start gap-2 text-sm text-slate-400 mt-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gold-accent shrink-0 mt-0.5">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
          </svg>
          <span>Jl. Raden Inten II No.66, RT.1/RW.7, Duren Sawit, Kec. Duren Sawit, Kota Jakarta Timur 13440</span>
        </div>
      </div>

      <div class="md:col-span-3 flex flex-col gap-3">
        <span class="font-display font-bold text-xs tracking-wider text-white uppercase">JELAJAHI</span>
        <div class="flex flex-col gap-2 text-sm">
          <a class="hover:text-gold-light transition-colors" href="/">Beranda</a>
          <a class="hover:text-gold-light transition-colors" href="/berita">Berita & Edukasi</a>
          <a class="hover:text-gold-light transition-colors" href="/tentang">Tentang Kami</a>
        </div>
      </div>

      <div class="md:col-span-3 flex flex-col gap-3">
        <span class="font-display font-bold text-xs tracking-wider text-white uppercase">BUTUH ARAH HUKUM?</span>
        <p class="text-sm text-slate-400">Hubungi admin untuk memulai percakapan awal.</p>
        <a class="inline-flex items-center gap-2 text-gold-accent hover:text-gold-light font-semibold text-sm transition-colors mt-1" href={whatsappUrl} rel="noopener noreferrer" target="_blank">
          <span>Mulai Chat WhatsApp</span>
          <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
        </a>
        <div class="flex items-center gap-4 mt-3">
          <a class="hover:text-gold-light transition-colors" href="#" aria-label="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a class="hover:text-gold-light transition-colors" href="#" aria-label="TikTok">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>© {year} Batavia 17. Informasi di situs ini bersifat umum dan bukan pengganti nasihat hukum profesional.</p>
      <div class="flex items-center gap-6">
        <a class="hover:text-slate-400 transition-colors" href="#">Kebijakan Privasi</a>
        <a class="hover:text-slate-400 transition-colors" href="#">Syarat & Ketentuan</a>
      </div>
    </div>
  </div>
</footer>
