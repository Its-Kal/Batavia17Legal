---
export const prerender = false;

import { supabase } from '../utils/supabase';

const year = new Date().getFullYear();

const { data: contactSection } = await supabase
  .from('landing_sections')
  .select('extra')
  .eq('section_key', 'contact')
  .single();

const whatsappNumber = contactSection?.extra?.whatsapp ?? '6285828331717';
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent('Halo Admin Batavia 17, saya butuh pendampingan untuk masalah tagihan.')}`;

const logoUrl = 'https://lh3.googleusercontent.com/aida-public/AB6AXuBuIfYd4CxD2KdgLpMgCAFjy_bG48gmOTv7boFeDa6jZRtchMHyK801NsbNmdgL1UMJLk9n0VR-FtJtgffqtfvi2uXQOqgMVt3X91IU8uF7hlghPKGI5uiF7gQhollYT9WTPMTIBwNo6nEZoHJrsO2G_3Qgo1xrpcKIe0krTqH8bRCbVWYvss9GGTzESEjfBCSfvqvodYShXrl6beybgARhiZ86UTsoeLF-tcAh3UjvW6GDQ0HMu5A4WmEUXDjc4PXFdQ';
---

<footer class="bg-[#050D1D] text-slate-400 border-t border-navy-border/60 pt-12 sm:pt-16 pb-8 sm:pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    {/* Main Grid */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-10 pb-8 sm:pb-12 border-b border-navy-border/50">

      {/* Section 1: Logo & Info */}
      <div class="sm:col-span-2 lg:col-span-6 flex flex-col items-center sm:items-start gap-4 sm:gap-3 lg:gap-4">
        <div class="flex flex-col sm:flex-row items-center sm:items-start gap-3 lg:gap-3">
          <img alt="Batavia 17 Logo" class="w-24 h-24 sm:w-28 sm:h-28 lg:w-36 lg:h-36 rounded-full object-cover ring-2 ring-gold-accent/40" src={logoUrl} />
          <div class="text-center sm:text-left">
            <span class="font-display font-bold text-white text-xl sm:text-2xl lg:text-2xl tracking-wide">BATAVIA 17</span>
          </div>
        </div>
        <p class="text-sm text-slate-400 max-w-md leading-relaxed text-center sm:text-left">
          Konsultan bantuan hukum — pendampingan yang berangkat dari kejelasan dan kepedulian.
        </p>
        <div class="flex items-start gap-2 text-sm text-slate-400 text-center sm:text-left">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gold-accent shrink-0 mt-0.5">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
          </svg>
          <span class="text-xs sm:text-sm">{contactSection?.extra?.address ?? 'Jl. Raden Inten II No.66, RT.1/RW.7, Duren Sawit, Kec. Duren Sawit, Kota Jakarta Timur 13440'}</span>
        </div>
      </div>

      {/* Section 2: Navigation */}
      <div class="lg:col-span-3 flex flex-col gap-3 text-center sm:text-left">
        <span class="font-display font-bold text-xs tracking-wider text-white uppercase">JELAJAHI</span>
        <div class="flex flex-col gap-2 text-sm">
          <a class="hover:text-gold-light transition-colors" href="/">Beranda</a>
          <a class="hover:text-gold-light transition-colors" href="/berita">Berita & Edukasi</a>
          <a class="hover:text-gold-light transition-colors" href="/tentang">Tentang Kami</a>
        </div>
      </div>

      {/* Section 3: Contact & Social */}
      <div class="lg:col-span-3 flex flex-col gap-3 text-center sm:text-left">
        <span class="font-display font-bold text-xs tracking-wider text-white uppercase">BUTUH ARAH HUKUM?</span>
        <p class="text-sm text-slate-400">Hubungi admin untuk memulai percakapan awal.</p>
        <a class="inline-flex items-center justify-center sm:justify-start gap-2 text-gold-accent hover:text-gold-light font-semibold text-sm transition-colors" href={whatsappUrl} rel="noopener noreferrer" target="_blank">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="shrink-0">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span>Mulai Chat WhatsApp</span>
        </a>
        <div class="flex items-center justify-center sm:justify-start gap-4 mt-3">
          <a class="hover:text-gold-light transition-colors" href="https://www.instagram.com/batavia17.legal" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a class="hover:text-gold-light transition-colors" href="https://www.tiktok.com/@batavia17.legal?_r=1&_t=ZS-9ABzMekGMQG" aria-label="TikTok" target="_blank" rel="noopener noreferrer">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    {/* Bottom Bar */}
    <div class="pt-6 sm:pt-8 flex flex-col sm:flex-row items-center justify-between gap-3 sm:gap-4 text-[10px] sm:text-xs text-slate-500">
      <p class="text-center sm:text-left">© {year} Batavia 17. Informasi di situs ini bersifat umum dan bukan pengganti nasihat hukum profesional.</p>
      <div class="flex items-center gap-4 sm:gap-6">
        <a class="hover:text-slate-400 transition-colors whitespace-nowrap" href="#">Kebijakan Privasi</a>
        <a class="hover:text-slate-400 transition-colors whitespace-nowrap" href="#">Syarat & Ketentuan</a>
      </div>
    </div>
  </div>
</footer>
