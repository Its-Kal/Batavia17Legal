---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabase } from '../../utils/supabase';

export const prerender = false;

const accessToken = Astro.cookies.get('sb-access-token')?.value;
if (!accessToken) return Astro.redirect('/admin/login?error=required');

const { data: { user } } = await supabase.auth.getUser(accessToken);
if (!user) {
  Astro.cookies.delete('sb-access-token', { path: '/' });
  Astro.cookies.delete('sb-refresh-token', { path: '/' });
  return Astro.redirect('/admin/login?error=required');
}

const { data: profile } = await supabase
  .from('profiles').select('role').eq('id', user.id).single();

const role = (profile?.role as 'admin_utama' | 'staff') ?? 'staff';

const { data: contents } = await supabase
  .from('content')
  .select('*')
  .order('updated_at', { ascending: false });
---

<AdminLayout title="Content — Batavia 17" activeMenu="content" userRole={role} userEmail={user.email ?? ''}>
  <div class="p-8">

    {/* Page header */}
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-2xl font-bold text-slate-900">Content</h1>
        <p class="text-slate-500 text-sm mt-1">Kelola halaman & artikel.</p>
      </div>
      <button id="btn-create" class="flex items-center gap-2 bg-[#0A1931] hover:bg-[#1a3a5c] text-white text-sm font-semibold px-4 py-2.5 rounded-lg transition-colors">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Tambah Content
      </button>
    </div>

    {/* Create / Edit form */}
    <div id="content-form" class="hidden bg-white rounded-xl border border-slate-200 p-6 mb-6">
      <h3 class="font-semibold text-slate-900 mb-4" id="form-title">Tambah Content</h3>
      <form id="content-form-el" class="space-y-4">
        <input type="hidden" name="id" id="form-id" value="" />
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Slug</label>
            <input type="text" name="slug" id="form-slug" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#0A1931]/30" placeholder="hukum-bisnis" required />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Judul</label>
            <input type="text" name="title" id="form-title-input" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#0A1931]/30" placeholder="Hukum Bisnis" required />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Tipe</label>
            <select name="type" id="form-type" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#0A1931]/30">
              <option value="page">Page</option>
              <option value="article">Article</option>
              <option value="service">Service</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Body (HTML/Markdown)</label>
          <textarea name="body" id="form-body" rows="6" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#0A1931]/30 font-mono" placeholder="Isi konten..."></textarea>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Status</label>
          <select name="status" id="form-status" class="border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#0A1931]/30">
            <option value="draft">Draft</option>
            <option value="published">Published</option>
          </select>
        </div>
        <div id="form-status-msg" class="hidden text-sm"></div>
        <div class="flex gap-3 pt-2">
          <button type="submit" class="bg-[#0A1931] hover:bg-[#1a3a5c] text-white text-sm font-semibold px-5 py-2 rounded-lg transition-colors">Simpan</button>
          <button type="button" id="btn-cancel" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-medium px-5 py-2 rounded-lg transition-colors">Batal</button>
        </div>
      </form>
    </div>

    {/* Content table */}
    <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
      <table class="w-full">
        <thead class="bg-slate-50 border-b border-slate-200">
          <tr>
            <th class="text-left px-6 py-3 text-xs font-semibold text-slate-600 uppercase tracking-wider">Judul / Slug</th>
            <th class="text-left px-6 py-3 text-xs font-semibold text-slate-600 uppercase tracking-wider">Tipe</th>
            <th class="text-left px-6 py-3 text-xs font-semibold text-slate-600 uppercase tracking-wider">Status</th>
            <th class="text-left px-6 py-3 text-xs font-semibold text-slate-600 uppercase tracking-wider">Diubah</th>
            <th class="text-right px-6 py-3 text-xs font-semibold text-slate-600 uppercase tracking-wider">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {(contents ?? []).map((c) => (
            <tr class="hover:bg-slate-50/60 transition-colors">
              <td class="px-6 py-4">
                <div class="font-medium text-sm text-slate-900">{c.title}</div>
                <div class="text-xs text-slate-400 font-mono">/{c.slug}</div>
              </td>
              <td class="px-6 py-4">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-700 border border-slate-200 capitalize">
                  {c.type}
                </span>
              </td>
              <td class="px-6 py-4">
                <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold ${
                  c.status === 'published'
                    ? 'bg-green-100 text-green-700 border border-green-200'
                    : 'bg-yellow-50 text-yellow-700 border border-yellow-200'
                }`}>
                  {c.status === 'published' ? 'Published' : 'Draft'}
                </span>
              </td>
              <td class="px-6 py-4 text-xs text-slate-500">
                {new Date(c.updated_at).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' })}
              </td>
              <td class="px-6 py-4 text-right">
                <div class="flex items-center justify-end gap-3">
                  <button class="text-xs text-blue-600 hover:text-blue-800 font-medium transition-colors btn-edit"
                    data-id={c.id} data-slug={c.slug} data-title={c.title}
                    data-body={c.body ?? ''} data-type={c.type} data-status={c.status}
                  >Edit</button>
                  {role === 'admin_utama' && (
                    <button class="text-xs text-red-600 hover:text-red-800 font-medium transition-colors btn-delete" data-id={c.id} data-title={c.title}>Hapus</button>
                  )}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      {(!contents || contents.length === 0) && (
        <div class="py-12 text-center text-slate-400 text-sm">Belum ada content. Klik "Tambah Content" untuk membuat.</div>
      )}
    </div>

    {/* Delete modal */}
    <div id="delete-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40">
      <div class="bg-white rounded-xl p-6 max-w-sm w-full mx-4 shadow-2xl">
        <h3 class="font-semibold text-slate-900 mb-2">Hapus Content?</h3>
        <p class="text-sm text-slate-600 mb-5">"<span id="delete-title"></span>" akan dihapus permanen.</p>
        <div class="flex justify-end gap-3">
          <button id="btn-delete-cancel" class="px-4 py-2 text-sm text-slate-600 hover:text-slate-900 font-medium">Batal</button>
          <button id="btn-delete-confirm" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-sm font-semibold rounded-lg">Hapus</button>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  // Show/hide form
  document.getElementById('btn-create')?.addEventListener('click', () => {
    document.getElementById('form-title')!.textContent = 'Tambah Content';
    (document.getElementById('form-id') as HTMLInputElement).value = '';
    (document.getElementById('content-form-el') as HTMLFormElement).reset();
    document.getElementById('content-form')?.classList.remove('hidden');
  });
  document.getElementById('btn-cancel')?.addEventListener('click', () => {
    document.getElementById('content-form')?.classList.add('hidden');
  });

  // Edit button
  document.querySelectorAll('.btn-edit').forEach(btn => {
    btn.addEventListener('click', () => {
      const el = btn as HTMLElement;
      document.getElementById('form-title')!.textContent = 'Edit Content';
      (document.getElementById('form-id') as HTMLInputElement).value = el.dataset.id ?? '';
      (document.getElementById('form-slug') as HTMLInputElement).value = el.dataset.slug ?? '';
      (document.getElementById('form-title-input') as HTMLInputElement).value = el.dataset.title ?? '';
      (document.getElementById('form-body') as HTMLTextAreaElement).value = el.dataset.body ?? '';
      (document.getElementById('form-type') as HTMLSelectElement).value = el.dataset.type ?? 'page';
      (document.getElementById('form-status') as HTMLSelectElement).value = el.dataset.status ?? 'draft';
      document.getElementById('content-form')?.classList.remove('hidden');
      document.getElementById('content-form')?.scrollIntoView({ behavior: 'smooth' });
    });
  });

  // Submit form
  document.getElementById('content-form-el')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const fd = new FormData(form);
    const id = fd.get('id') as string;
    const payload = {
      slug: fd.get('slug') as string,
      title: fd.get('title') as string,
      body: fd.get('body') as string,
      type: fd.get('type') as string,
      status: fd.get('status') as string,
      updated_at: new Date().toISOString(),
    };
    const msgEl = document.getElementById('form-status-msg')!;

    let error;
    if (id) {
      const { error: err } = await supabase.from('content').update(payload).eq('id', id);
      error = err;
    } else {
      const { error: err } = await supabase.from('content').insert({ ...payload, author_id: null });
      error = err;
    }

    if (error) {
      msgEl.className = 'text-sm text-red-600';
      msgEl.textContent = '✗ ' + error.message;
    } else {
      msgEl.className = 'text-sm text-green-600';
      msgEl.textContent = '✓ Tersimpan! Memuat ulang...';
      setTimeout(() => location.reload(), 1200);
    }
    msgEl.classList.remove('hidden');
  });

  // Delete
  let deleteTargetId = '';
  document.querySelectorAll('.btn-delete').forEach(btn => {
    btn.addEventListener('click', () => {
      deleteTargetId = (btn as HTMLElement).dataset.id ?? '';
      document.getElementById('delete-title')!.textContent = (btn as HTMLElement).dataset.title ?? '';
      document.getElementById('delete-modal')!.classList.remove('hidden');
    });
  });
  document.getElementById('btn-delete-cancel')?.addEventListener('click', () => {
    document.getElementById('delete-modal')!.classList.add('hidden');
  });
  document.getElementById('btn-delete-confirm')?.addEventListener('click', async () => {
    if (!deleteTargetId) return;
    await supabase.from('content').delete().eq('id', deleteTargetId);
    document.getElementById('delete-modal')!.classList.add('hidden');
    location.reload();
  });
</script>
