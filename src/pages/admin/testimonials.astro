---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabase } from '../../utils/supabase';
import { createClient } from '@supabase/supabase-js';

export const prerender = false;

const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const SUPABASE_SERVICE_ROLE_KEY = import.meta.env.SUPABASE_SERVICE_ROLE_KEY ?? '';

// Service role client — bypass RLS untuk lihat semua testimonials
const supabaseAdmin = SUPABASE_SERVICE_ROLE_KEY
  ? createClient(SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY)
  : supabase;

const accessToken = Astro.cookies.get('sb-access-token')?.value;
if (!accessToken) return Astro.redirect('/admin/login?error=required');

const { data: { user } } = await supabase.auth.getUser(accessToken);
if (!user) {
  Astro.cookies.delete('sb-access-token', { path: '/' });
  Astro.cookies.delete('sb-refresh-token', { path: '/' });
  return Astro.redirect('/admin/login?error=required');
}

const { data: profile } = await supabase
  .from('profiles').select('role').eq('id', user.id).single();

const role = (profile?.role as 'admin_utama' | 'staff') ?? 'staff';
if (role !== 'admin_utama') return Astro.redirect('/admin');

  // Fetch semua testimonials (service role bypasses RLS)
const { data: testimonials } = await supabaseAdmin
  .from('testimonials')
  .select('*')
  .order('created_at', { ascending: false });

const allTestimonials = testimonials ?? [];
const pending = allTestimonials.filter(t => !t.is_approved);
const approved = allTestimonials.filter(t => t.is_approved);
---

<AdminLayout title="Testimoni — Batavia 17" activeMenu="testimonials" userRole="admin_utama" userEmail={user.email ?? ''}>
  <div class="p-8">

    {/* Page header */}
    <div class="mb-8">
      <h1 class="text-2xl font-bold text-slate-900">Testimoni</h1>
      <p class="text-slate-500 text-sm mt-1">Kelola testimoni yang masuk dari pengunjung.</p>
    </div>

    {/* Summary */}
    <div class="grid grid-cols-3 gap-4 mb-8">
      <div class="bg-white rounded-xl p-5 border border-slate-200">
        <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Total Masuk</div>
        <div class="text-3xl font-extrabold text-slate-900">{allTestimonials.length}</div>
      </div>
      <div class="bg-white rounded-xl p-5 border border-slate-200">
        <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Menunggu</div>
        <div class="text-3xl font-extrabold text-yellow-500">{pending.length}</div>
      </div>
      <div class="bg-white rounded-xl p-5 border border-slate-200">
        <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Tayang</div>
        <div class="text-3xl font-extrabold text-green-600">{approved.length}</div>
      </div>
    </div>

    {/* Tabs */}
    <div class="flex gap-2 mb-4">
      <button class="tab-btn active" data-tab="pending">Menunggu ({pending.length})</button>
      <button class="tab-btn" data-tab="approved">Diterima ({approved.length})</button>
      <button class="tab-btn" data-tab="all">Semua ({allTestimonials.length})</button>
    </div>

    {/* Cards */}
    <div id="pending-panel" class="space-y-4">
      {pending.length === 0 && (
        <div class="bg-white rounded-xl border border-slate-200 p-10 text-center text-slate-400 text-sm">
          Tidak ada testimoni menunggu persetujuan.
        </div>
      )}
      {pending.map(t => (
        <div class="testimonial-card bg-white rounded-xl border border-slate-200 p-5" data-status="pending" data-id={t.id}>
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-full bg-slate-100 border border-slate-200 flex items-center justify-center text-sm font-bold text-slate-500 flex-shrink-0">
              {(t.name ?? '?').slice(0, 2).toUpperCase()}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="font-semibold text-slate-900">{t.name}</span>
                {t.company && <span class="text-xs text-slate-400">· {t.company}</span>}
                {t.location && <span class="text-xs text-slate-400">· {t.location}</span>}
              </div>
              <div class="flex items-center gap-1 mt-1">
                {Array.from({length: 5}).map((_, i) => (
                  <svg width="12" height="12" viewBox="0 0 24 24" fill={i < (t.rating ?? 0) ? '#D4AF37' : '#e2e8f0'} stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                ))}
              </div>
              <p class="text-sm text-slate-600 mt-2 leading-relaxed">{t.content}</p>
              <div class="text-xs text-slate-400 mt-2">
                {new Date(t.created_at).toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' })}
              </div>
            </div>
            <div class="flex flex-col gap-2 flex-shrink-0">
              <button
                class="btn-approve text-xs bg-green-600 hover:bg-green-700 text-white font-semibold px-4 py-2 rounded-lg transition-colors"
                data-id={t.id} data-name={t.name}
              >✓ Terima</button>
              <button
                class="btn-reject text-xs bg-red-50 hover:bg-red-100 text-red-600 font-medium px-4 py-2 rounded-lg border border-red-200 transition-colors"
                data-id={t.id} data-name={t.name}
              >✗ Tolak</button>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div id="approved-panel" class="hidden space-y-4">
      {approved.map(t => (
        <div class="testimonial-card bg-white rounded-xl border border-slate-200 p-5" data-status="approved" data-id={t.id}>
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-full bg-[#0A1931] flex items-center justify-center text-sm font-bold text-white flex-shrink-0">
              {(t.name ?? '?').slice(0, 2).toUpperCase()}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="font-semibold text-slate-900">{t.name}</span>
                {t.company && <span class="text-xs text-slate-400">· {t.company}</span>}
                {t.location && <span class="text-xs text-slate-400">· {t.location}</span>}
              </div>
              <div class="flex items-center gap-1 mt-1">
                {Array.from({length: 5}).map((_, i) => (
                  <svg width="12" height="12" viewBox="0 0 24 24" fill={i < (t.rating ?? 0) ? '#D4AF37' : '#e2e8f0'} stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                ))}
              </div>
              <p class="text-sm text-slate-600 mt-2 leading-relaxed">{t.content}</p>
              <div class="text-xs text-slate-400 mt-2">
                Dipublikasikan {new Date(t.updated_at).toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' })}
              </div>
            </div>
            <div class="flex flex-col gap-2 flex-shrink-0">
              <span class="text-xs text-green-600 font-semibold bg-green-50 border border-green-200 px-3 py-1.5 rounded-lg text-center">✓ Tayang</span>
              <button
                class="btn-unpublish text-xs bg-slate-50 hover:bg-slate-100 text-slate-500 font-medium px-4 py-2 rounded-lg border border-slate-200 transition-colors"
                data-id={t.id} data-name={t.name}
              >Tarik</button>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div id="all-panel" class="hidden space-y-4">
      {allTestimonials.map(t => (
        <div class="testimonial-card bg-white rounded-xl border border-slate-200 p-5" data-status="all" data-id={t.id}>
          <div class="flex items-start gap-4">
            <div class={`w-11 h-11 rounded-full flex items-center justify-center text-sm font-bold flex-shrink-0 ${t.is_approved ? 'bg-[#0A1931] text-white' : 'bg-slate-100 border border-slate-200 text-slate-500'}`}>
              {(t.name ?? '?').slice(0, 2).toUpperCase()}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="font-semibold text-slate-900">{t.name}</span>
                {t.company && <span class="text-xs text-slate-400">· {t.company}</span>}
                <span class={`text-xs font-semibold px-2 py-0.5 rounded-full ${t.is_approved ? 'bg-green-50 text-green-700 border border-green-200' : 'bg-yellow-50 text-yellow-700 border border-yellow-200'}`}>
                  {t.is_approved ? '✓ Tayang' : '⏳ Menunggu'}
                </span>
              </div>
              <div class="flex items-center gap-1 mt-1">
                {Array.from({length: 5}).map((_, i) => (
                  <svg width="12" height="12" viewBox="0 0 24 24" fill={i < (t.rating ?? 0) ? '#D4AF37' : '#e2e8f0'} stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                ))}
              </div>
              <p class="text-sm text-slate-600 mt-2 leading-relaxed">{t.content}</p>
            </div>
            <div class="flex flex-col gap-2 flex-shrink-0">
              {t.is_approved ? (
                <>
                  <span class="text-xs text-green-600 font-semibold bg-green-50 border border-green-200 px-3 py-1.5 rounded-lg text-center">✓ Tayang</span>
                  <button class="btn-unpublish text-xs bg-slate-50 hover:bg-slate-100 text-slate-500 font-medium px-4 py-2 rounded-lg border border-slate-200 transition-colors" data-id={t.id} data-name={t.name}>Tarik</button>
                </>
              ) : (
                <>
                  <button class="btn-approve text-xs bg-green-600 hover:bg-green-700 text-white font-semibold px-4 py-2 rounded-lg transition-colors" data-id={t.id} data-name={t.name}>✓ Terima</button>
                  <button class="btn-reject text-xs bg-red-50 hover:bg-red-100 text-red-600 font-medium px-4 py-2 rounded-lg border border-red-200 transition-colors" data-id={t.id} data-name={t.name}>✗ Tolak</button>
                </>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</AdminLayout>

<script>
  import { createClient } from '@supabase/supabase-js';
  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  // Tabs
  const tabs = document.querySelectorAll('.tab-btn');
  const panels: Record<string, HTMLElement | null> = {
    pending: document.getElementById('pending-panel'),
    approved: document.getElementById('approved-panel'),
    all: document.getElementById('all-panel'),
  };

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const target = (tab as HTMLElement).dataset.tab ?? 'pending';
      Object.entries(panels).forEach(([k, el]) => {
        el?.classList.toggle('hidden', k !== target);
      });
    });
  });

  // Approve via service role API
  document.querySelectorAll('.btn-approve').forEach(btn => {
    btn.addEventListener('click', async () => {
      const el = btn as HTMLElement;
      if (!confirm(`Terima testimoni dari "${el.dataset.name}"?`)) return;
      const res = await fetch('/api/admin-testimonials', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: el.dataset.id, is_approved: true }),
      });
      if (!res.ok) {
        const r = await res.json();
        alert('Gagal: ' + (r.error ?? 'Unknown error'));
        return;
      }
      location.reload();
    });
  });

  // Reject / Unpublish via service role API
  document.querySelectorAll('.btn-reject, .btn-unpublish').forEach(btn => {
    btn.addEventListener('click', async () => {
      const el = btn as HTMLElement;
      if (!confirm(`Tolak / tarik testimoni dari "${el.dataset.name}"?`)) return;
      const res = await fetch('/api/admin-testimonials', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: el.dataset.id, is_approved: false }),
      });
      if (!res.ok) {
        const r = await res.json();
        alert('Gagal: ' + (r.error ?? 'Unknown error'));
        return;
      }
      location.reload();
    });
  });
</script>

<style>
  .tab-btn {
    @apply px-4 py-1.5 rounded-full text-xs font-semibold transition-all cursor-pointer border;
    @apply text-slate-500 border-slate-200 bg-white hover:bg-slate-50;
  }
  .tab-btn.active {
    @apply bg-[#0A1931] text-white border-[#0A1931];
  }
</style>
