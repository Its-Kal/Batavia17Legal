---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabase } from '../../utils/supabase';

export const prerender = false;

const accessToken = Astro.cookies.get('sb-access-token')?.value;
if (!accessToken) return Astro.redirect('/admin/login?error=required');

const { data: { user } } = await supabase.auth.getUser(accessToken);
if (!user) {
  Astro.cookies.delete('sb-access-token', { path: '/' });
  Astro.cookies.delete('sb-refresh-token', { path: '/' });
  return Astro.redirect('/admin/login?error=required');
}

const { data: profile } = await supabase
  .from('profiles').select('role').eq('id', user.id).single();

const role = (profile?.role as 'admin_utama' | 'staff') ?? 'staff';

if (role !== 'admin_utama') {
  return Astro.redirect('/admin');
}

const { data: profiles } = await supabase
  .from('profiles')
  .select('*')
  .order('created_at', { ascending: false });
---

<AdminLayout title="User — Batavia 17" activeMenu="user" userRole={role} userEmail={user.email ?? ''}>
  <div class="p-8">

    {/* Page header */}
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-2xl font-bold text-slate-900">Manajemen User</h1>
        <p class="text-slate-500 text-sm mt-1">Kelola akun admin & staff.</p>
      </div>
      <button id="btn-create" class="flex items-center gap-2 bg-[#0A1931] hover:bg-[#1a3a5c] text-white text-sm font-semibold px-4 py-2.5 rounded-lg transition-colors">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Tambah User
      </button>
    </div>

    {/* Create user form */}
    <div id="create-form" class="hidden bg-white rounded-xl border border-slate-200 p-6 mb-6">
      <h3 class="font-semibold text-slate-900 mb-4">Buat Akun Baru</h3>
      <form id="new-user-form" class="space-y-4 max-w-lg">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Lengkap</label>
          <input type="text" name="full_name" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#0A1931]/30" placeholder="John Doe" required />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Email</label>
          <input type="email" name="email" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#0A1931]/30" placeholder="staff@batavia17.legal" required />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Password</label>
          <input type="password" name="password" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#0A1931]/30" placeholder="Minimal 6 karakter" minlength="6" required />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Role</label>
          <select name="role" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#0A1931]/30">
            <option value="staff">Staff</option>
            <option value="admin_utama">Admin Utama</option>
          </select>
        </div>
        <div id="form-status" class="hidden text-sm"></div>
        <div class="flex gap-3 pt-2">
          <button type="submit" class="bg-[#0A1931] hover:bg-[#1a3a5c] text-white text-sm font-semibold px-5 py-2 rounded-lg transition-colors">Simpan</button>
          <button type="button" id="btn-cancel" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-medium px-5 py-2 rounded-lg transition-colors">Batal</button>
        </div>
      </form>
    </div>

    {/* Users table */}
    <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
      <table class="w-full">
        <thead class="bg-slate-50 border-b border-slate-200">
          <tr>
            <th class="text-left px-6 py-3 text-xs font-semibold text-slate-600 uppercase tracking-wider">User</th>
            <th class="text-left px-6 py-3 text-xs font-semibold text-slate-600 uppercase tracking-wider">Role</th>
            <th class="text-left px-6 py-3 text-xs font-semibold text-slate-600 uppercase tracking-wider">Terdaftar</th>
            <th class="text-right px-6 py-3 text-xs font-semibold text-slate-600 uppercase tracking-wider">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {(profiles ?? []).map((p) => (
            <tr class="hover:bg-slate-50/60 transition-colors">
              <td class="px-6 py-4">
                <div class="font-medium text-sm text-slate-900">{p.full_name ?? '-'}</div>
                <div class="text-xs text-slate-500">{p.email}</div>
              </td>
              <td class="px-6 py-4">
                <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold ${
                  p.role === 'admin_utama'
                    ? 'bg-[#D4AF37]/10 text-[#9A7B2A] border border-[#D4AF37]/30'
                    : 'bg-blue-50 text-blue-700 border border-blue-200'
                }`}>
                  {p.role === 'admin_utama' ? 'Admin Utama' : 'Staff'}
                </span>
              </td>
              <td class="px-6 py-4 text-xs text-slate-500">
                {new Date(p.created_at).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' })}
              </td>
              <td class="px-6 py-4 text-right">
                {p.id !== user.id ? (
                  <div class="flex items-center justify-end gap-2">
                    <button
                      class="text-xs text-red-600 hover:text-red-800 font-medium transition-colors"
                      data-delete-id={p.id}
                      data-email={p.email}
                    >Hapus</button>
                  </div>
                ) : (
                  <span class="text-xs text-slate-400 italic">Anda</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      {(!profiles || profiles.length === 0) && (
        <div class="py-12 text-center text-slate-400 text-sm">Belum ada user.</div>
      )}
    </div>

    {/* Delete confirm modal */}
    <div id="delete-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40">
      <div class="bg-white rounded-xl p-6 max-w-sm w-full mx-4 shadow-2xl">
        <h3 class="font-semibold text-slate-900 mb-2">Hapus User?</h3>
        <p class="text-sm text-slate-600 mb-5">User <strong id="delete-email"></strong> akan dihapus permanen.</p>
        <div class="flex justify-end gap-3">
          <button id="btn-delete-cancel" class="px-4 py-2 text-sm text-slate-600 hover:text-slate-900 font-medium">Batal</button>
          <button id="btn-delete-confirm" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-sm font-semibold rounded-lg">Hapus</button>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  // Create user form toggle
  document.getElementById('btn-create')?.addEventListener('click', () => {
    document.getElementById('create-form')?.classList.remove('hidden');
  });
  document.getElementById('btn-cancel')?.addEventListener('click', () => {
    document.getElementById('create-form')?.classList.add('hidden');
    (document.getElementById('new-user-form') as HTMLFormElement)?.reset();
  });

  // Create new user
  document.getElementById('new-user-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const fd = new FormData(form);
    const status = document.getElementById('form-status')!;

    const { error } = await supabase.auth.admin.createUser({
      email: fd.get('email') as string,
      password: fd.get('password') as string,
      email_confirm: true,
      user_metadata: { full_name: fd.get('full_name'), role: fd.get('role') },
    });

    if (error) {
      status.className = 'text-sm text-red-600';
      status.textContent = '✗ ' + error.message;
      status.classList.remove('hidden');
    } else {
      status.className = 'text-sm text-green-600';
      status.textContent = '✓ User berhasil dibuat. Halaman akan diperbarui...';
      status.classList.remove('hidden');
      setTimeout(() => location.reload(), 1500);
    }
  });

  // Delete user
  let deleteTargetId = '';
  document.querySelectorAll('[data-delete-id]').forEach(btn => {
    btn.addEventListener('click', () => {
      deleteTargetId = (btn as HTMLElement).dataset.deleteId ?? '';
      document.getElementById('delete-email')!.textContent = (btn as HTMLElement).dataset.email ?? '';
      document.getElementById('delete-modal')!.classList.remove('hidden');
    });
  });

  document.getElementById('btn-delete-cancel')?.addEventListener('click', () => {
    document.getElementById('delete-modal')!.classList.add('hidden');
  });

  document.getElementById('btn-delete-confirm')?.addEventListener('click', async () => {
    if (!deleteTargetId) return;
    const { error } = await supabase.auth.admin.deleteUser(deleteTargetId);
    document.getElementById('delete-modal')!.classList.add('hidden');
    if (error) {
      alert('Gagal hapus: ' + error.message);
    } else {
      location.reload();
    }
  });
</script>
