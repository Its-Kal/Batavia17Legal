---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { supabase, supabaseAdmin } from '../../../utils/supabase';

export const prerender = false;

const accessToken = Astro.cookies.get('sb-access-token')?.value;
if (!accessToken) return Astro.redirect('/admin/login?error=required');

const { data: { user } } = await supabase.auth.getUser(accessToken);
if (!user) {
  Astro.cookies.delete('sb-access-token', { path: '/' });
  Astro.cookies.delete('sb-refresh-token', { path: '/' });
  return Astro.redirect('/admin/login?error=required');
}

const { data: profile } = await supabase
  .from('profiles').select('role').eq('id', user.id).single();

const role = (profile?.role as 'admin_utama' | 'staff') ?? 'staff';
if (role !== 'admin_utama') return Astro.redirect('/admin');

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/video-ads');

const { data: video } = await supabaseAdmin
  .from('video_ads').select('*').eq('id', id).single();

if (!video) return Astro.redirect('/admin/video-ads');

// Parse video URL
function parseVideoUrl(url: string | null) {
  if (!url) return { type: 'none' as const, driveId: null, directUrl: null, isDrive: false };

  // Google Drive file URL
  const driveMatch = String(url).match(/\/file\/d\/([^/]+)\//);
  if (driveMatch) {
    return {
      type: 'drive' as const,
      driveId: driveMatch[1],
      directUrl: `https://drive.google.com/file/d/${driveMatch[1]}/view`,
      isDrive: true,
    };
  }

  // Direct video URL (mp4, webm, etc.)
  if (/\.(mp4|webm|mov|avi|m4v)(\?.*)?$/i.test(url)) {
    return { type: 'direct' as const, driveId: null, directUrl: url, isDrive: false };
  }

  // YouTube / TikTok embeds
  const tiktokMatch = url.match(/tiktok\.com\/@[^/]+\/video\/(\d+)/);
  if (url.includes('youtube.com') || url.includes('youtu.be')) {
    return { type: 'embed' as const, driveId: null, directUrl: url, isDrive: false };
  }
  if (tiktokMatch) {
    return {
      type: 'tiktok' as const,
      driveId: null,
      directUrl: `https://www.tiktok.com/embed/v2/${tiktokMatch[1]}`,
      isDrive: false,
    };
  }

  // Local / other file name
  return { type: 'local' as const, driveId: null, directUrl: url, isDrive: false };
}

const parsed = parseVideoUrl(video.video_url);
const isPublished = video.is_active;
---

<AdminLayout title={`${video.title} — Video Iklan`} activeMenu="video-ads" userRole="admin_utama" userEmail={user.email ?? ''}>
  <div class="min-h-screen bg-slate-100">

    {/* Top bar — mobile friendly */}
    <div class="bg-white border-b border-slate-200 px-4 py-3 flex items-center justify-between sticky top-0 z-10">
      <a href="/admin/video-ads" class="flex items-center gap-2 text-sm text-slate-500 hover:text-[#0A1931] transition-colors">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
        <span class="hidden sm:inline">Kembali</span>
      </a>
      <div class="flex items-center gap-2">
        {isPublished ? (
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-green-100 text-green-700 border border-green-200">
            <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
            Published
          </span>
        ) : (
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-500 border border-slate-200">Draft</span>
        )}
      </div>
    </div>

    <div class="max-w-5xl mx-auto px-4 py-6">

      {/* Title row */}
      <div class="mb-5">
        <h1 class="text-lg sm:text-xl font-bold text-slate-900 leading-tight mb-2">{video.title}</h1>
        <div class="flex flex-wrap items-center gap-2 text-xs text-slate-400">
          {video.category && (
            <span class="bg-[#0A1931]/5 text-[#0A1931] px-2 py-0.5 rounded-full font-medium">{video.category}</span>
          )}
          {video.synced_at && (
            <span>Synced {new Date(video.synced_at).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' })}</span>
          )}
          <span>Order #{video.display_order}</span>
        </div>
      </div>

      {/* Main grid: video player + sidebar */}
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">

        {/* LEFT — Video Player */}
        <div class="lg:col-span-2 space-y-4">
          <div class="bg-black rounded-xl overflow-hidden aspect-video relative" style="min-height: 220px;">
            {parsed.type === 'drive' && parsed.driveId ? (
              <iframe
                src={`https://drive.google.com/file/d/${parsed.driveId}/preview`}
                class="w-full h-full absolute inset-0"
                allow="autoplay; fullscreen"
                title={video.title}
              ></iframe>
            ) : parsed.type === 'direct' ? (
              <video
                src={parsed.directUrl!}
                controls
                controlsList="nodownload"
                class="w-full h-full absolute inset-0"
                title={video.title}
              ></video>
            ) : parsed.type === 'embed' || parsed.type === 'tiktok' ? (
              <iframe
                src={parsed.directUrl!}
                class="w-full h-full absolute inset-0"
                allow="autoplay; fullscreen"
                title={video.title}
              ></iframe>
            ) : (
              <div class="w-full h-full absolute inset-0 flex flex-col items-center justify-center gap-3 bg-slate-900">
                <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" class="text-white/30" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                <div class="text-center px-4">
                  <p class="text-white/50 text-sm mb-1">Video tidak bisa diputar langsung</p>
                  <p class="text-white/30 text-xs">{video.video_url}</p>
                </div>
              </div>
            )}
          </div>

          {/* Action buttons */}
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
            {parsed.isDrive && (
              <a href={parsed.directUrl!} target="_blank" rel="noopener noreferrer"
                class="flex items-center justify-center gap-2 px-4 py-3 bg-[#0A1931] hover:bg-[#1a3a5c] text-white text-sm font-semibold rounded-xl transition-colors">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                Buka di Drive
              </a>
            )}
            {parsed.type === 'direct' ? (
              <a href={parsed.directUrl!}
                class="flex items-center justify-center gap-2 px-4 py-3 bg-green-600 hover:bg-green-700 text-white text-sm font-semibold rounded-xl transition-colors"
                download target="_blank" rel="noopener noreferrer">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Download
              </a>
            ) : parsed.isDrive ? (
              <a href={`https://docs.google.com/uc?export=download&id=${parsed.driveId}`}
                class="flex items-center justify-center gap-2 px-4 py-3 bg-green-600 hover:bg-green-700 text-white text-sm font-semibold rounded-xl transition-colors"
                download>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Download
              </a>
            ) : null}
            <button id="btn-copy-full"
              class="flex items-center justify-center gap-2 px-4 py-3 bg-[#D4AF37] hover:bg-[#c9a430] text-[#0A1931] text-sm font-bold rounded-xl transition-colors col-span-2 sm:col-span-1">
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              Copy Caption + Tag
            </button>
          </div>

          {/* Video URL badge */}
          {video.video_url && (
            <div class="bg-white rounded-xl border border-slate-200 p-4">
              <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Video URL</div>
              <div class="text-sm text-slate-700 break-all">{video.video_url}</div>
            </div>
          )}
        </div>

        {/* RIGHT — Caption, Hashtag, Info */}
        <div class="space-y-4">

          {/* Caption */}
          <div class="bg-white rounded-xl border border-slate-200 p-4">
            <div class="flex items-center justify-between mb-3">
              <h2 class="font-semibold text-slate-800 text-sm">Caption</h2>
              <button id="btn-copy-caption" class="flex items-center gap-1.5 text-xs text-slate-400 hover:text-[#D4AF37] transition-colors">
                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                Copy
              </button>
            </div>
            <div id="caption-text" class="text-sm text-slate-700 leading-relaxed whitespace-pre-wrap">
              {video.caption
                ? <span set:html={video.caption.replace(/\n/g, '<br/>')} />
                : <span class="text-slate-300 italic">Belum ada caption</span>
              }
            </div>
          </div>

          {/* Hashtags */}
          <div class="bg-white rounded-xl border border-slate-200 p-4">
            <div class="flex items-center justify-between mb-3">
              <h2 class="font-semibold text-slate-800 text-sm">Hashtag</h2>
              <button id="btn-copy-hashtags" class="flex items-center gap-1.5 text-xs text-slate-400 hover:text-[#D4AF37] transition-colors">
                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                Copy
              </button>
            </div>
            <div id="hashtags-container" class="flex flex-wrap gap-2">
              {video.hashtags && video.hashtags.length > 0 ? (
                video.hashtags.map((tag: string) => (
                  <span class="text-xs font-semibold text-[#D4AF37] bg-[#D4AF37]/10 border border-[#D4AF37]/20 px-3 py-1 rounded-full">
                    #{tag}
                  </span>
                ))
              ) : (
                <span class="text-xs text-slate-300 italic">Belum ada hashtag</span>
              )}
            </div>
          </div>

          {/* Info */}
          <div class="bg-white rounded-xl border border-slate-200 p-4">
            <h2 class="font-semibold text-slate-800 text-sm mb-3">Info Video</h2>
            <dl class="space-y-2 text-sm">
              <div class="flex justify-between">
                <dt class="text-slate-400">Platform</dt>
                <dd class="font-semibold text-slate-700">{video.category || 'TikTok'}</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-slate-400">Status</dt>
                <dd class={`font-semibold ${isPublished ? 'text-green-600' : 'text-slate-400'}`}>
                  {isPublished ? 'Published' : 'Draft'}
                </dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-slate-400">Urutan</dt>
                <dd class="font-semibold text-slate-700">#{video.display_order}</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-slate-400">Hashtag</dt>
                <dd class="font-semibold text-slate-700">{video.hashtags?.length ?? 0} tag</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-slate-400">Created</dt>
                <dd class="font-semibold text-slate-700">{new Date(video.created_at).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' })}</dd>
              </div>
            </dl>
          </div>

          {/* Publish toggle */}
          <div class="flex gap-2">
            <button id="btn-toggle-publish"
              class={`flex-1 flex items-center justify-center gap-2 px-4 py-3 rounded-xl text-sm font-bold transition-colors ${
                isPublished
                  ? 'bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200'
                  : 'bg-green-600 hover:bg-green-700 text-white'
              }`}>
              {isPublished ? (
                <>
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12"/></svg>
                  Unpublish
                </>
              ) : (
                <>
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                  Publish
                </>
              )}
            </button>
            <button id="btn-delete-video"
              class="flex items-center justify-center px-4 py-3 rounded-xl text-sm font-semibold bg-red-50 hover:bg-red-100 text-red-600 border border-red-200 transition-colors">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
            </button>
          </div>

        </div>
      </div>
    </div>
  </div>
</AdminLayout>

{/* Delete confirm modal */}
<div id="delete-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4">
  <div class="bg-white rounded-2xl p-6 max-w-sm w-full shadow-2xl">
    <h3 class="font-bold text-slate-900 mb-2">Hapus Video?</h3>
    <p class="text-sm text-slate-500 mb-5">Video ini akan dihapus permanen dan tidak bisa dikembalikan.</p>
    <div class="flex gap-3">
      <button id="btn-delete-cancel" class="flex-1 px-4 py-2 text-sm text-slate-600 hover:text-slate-900 font-medium rounded-lg hover:bg-slate-100 transition-colors">Batal</button>
      <button id="btn-delete-confirm" class="flex-1 px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-sm font-bold rounded-xl">Hapus</button>
    </div>
  </div>
</div>

{/* Toast */}
<div id="toast" class="hidden fixed bottom-4 left-1/2 -translate-x-1/2 z-[100] px-5 py-3 rounded-xl shadow-lg text-sm font-semibold text-white bg-slate-800 whitespace-nowrap"></div>

<script>
  import { createClient } from '@supabase/supabase-js';
  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );
  const videoId = window.location.pathname.split('/').pop() ?? '';

  function showToast(msg: string, isError = false) {
    const el = document.getElementById('toast')!;
    el.textContent = msg;
    el.className = `fixed bottom-4 left-1/2 -translate-x-1/2 z-[100] px-5 py-3 rounded-xl shadow-lg text-sm font-semibold text-white whitespace-nowrap ${isError ? 'bg-red-600' : 'bg-slate-800'}`;
    el.classList.remove('hidden');
    setTimeout(() => el.classList.add('hidden'), 3000);
  }

  async function copyText(text: string, label = 'disalin') {
    try {
      await navigator.clipboard.writeText(text);
      showToast(`✓ Berhasil ${label}!`);
    } catch {
      showToast('Gagal menyalin.', true);
    }
  }

  // Publish / Unpublish
  document.getElementById('btn-toggle-publish')?.addEventListener('click', async () => {
    const btn = document.getElementById('btn-toggle-publish') as HTMLButtonElement;
    const isCurrentlyPublished = btn.textContent?.includes('Unpublish') ?? false;
    btn.disabled = true;
    btn.textContent = '...';

    const { error } = await supabase
      .from('video_ads')
      .update({ is_active: !isCurrentlyPublished, updated_at: new Date().toISOString() })
      .eq('id', videoId);

    if (error) {
      showToast('Gagal update: ' + error.message, true);
      btn.textContent = isCurrentlyPublished ? 'Unpublish' : 'Publish';
      btn.disabled = false;
      return;
    }

    showToast(isCurrentlyPublished ? '✓ Di-unpublish.' : '✓ Dipublish!');
    setTimeout(() => location.reload(), 600);
  });

  // Copy caption
  document.getElementById('btn-copy-caption')?.addEventListener('click', () => {
    const el = document.getElementById('caption-text');
    const text = el?.innerText?.trim() ?? '';
    if (!text || el?.querySelector('span[style]')) {
      showToast('Tidak ada caption untuk disalin.', true);
      return;
    }
    copyText(text, 'caption disalin');
  });

  // Copy hashtags
  document.getElementById('btn-copy-hashtags')?.addEventListener('click', () => {
    const tags = Array.from(document.querySelectorAll('#hashtags-container span'))
      .map((el) => el.textContent?.trim() ?? '').filter(Boolean);
    if (!tags.length) { showToast('Tidak ada hashtag.', true); return; }
    copyText(tags.join(' '), 'hashtag disalin');
  });

  // Copy full caption + hashtags
  function copyFull() {
    const caption = document.getElementById('caption-text')?.innerText?.trim() ?? '';
    const tags = Array.from(document.querySelectorAll('#hashtags-container span'))
      .map((el) => el.textContent?.trim() ?? '').filter(Boolean);
    const full = caption + (tags.length ? '\n\n' + tags.join(' ') : '');
    copyText(full, 'caption + hashtag disalin');
  }
  document.getElementById('btn-copy-full')?.addEventListener('click', copyFull);

  // Delete
  document.getElementById('btn-delete-video')?.addEventListener('click', () => {
    document.getElementById('delete-modal')?.classList.remove('hidden');
  });
  document.getElementById('btn-delete-cancel')?.addEventListener('click', () => {
    document.getElementById('delete-modal')?.classList.add('hidden');
  });
  document.getElementById('btn-delete-confirm')?.addEventListener('click', async () => {
    document.getElementById('delete-modal')?.classList.add('hidden');
    const res = await fetch('/api/admin-video-ads', {
      method: 'DELETE', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: videoId }),
    });
    if (!res.ok) {
      const result = await res.json();
      showToast('Gagal hapus: ' + (result.error ?? ''), true);
      return;
    }
    showToast('✓ Video dihapus.');
    setTimeout(() => window.location.href = '/admin/video-ads', 800);
  });
</script>
