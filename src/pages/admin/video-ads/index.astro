---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { supabase, supabaseAdmin } from '../../../utils/supabase';

export const prerender = false;

const accessToken = Astro.cookies.get('sb-access-token')?.value;
if (!accessToken) return Astro.redirect('/admin/login?error=required');

const { data: { user } } = await supabase.auth.getUser(accessToken);
if (!user) {
  Astro.cookies.delete('sb-access-token', { path: '/' });
  Astro.cookies.delete('sb-refresh-token', { path: '/' });
  return Astro.redirect('/admin/login?error=required');
}

const { data: profile } = await supabase
  .from('profiles').select('role').eq('id', user.id).single();

const role = (profile?.role as 'admin_utama' | 'staff') ?? 'staff';
if (role !== 'admin_utama') return Astro.redirect('/admin');

// Server-side env vars for auto-sync
const spreadsheetId = import.meta.env.GOOGLE_SHEETS_SPREADSHEET_ID;
const sheetName = import.meta.env.GOOGLE_SHEETS_SHEET_NAME || 'Videos';
const hasAutoSyncConfig = !!spreadsheetId;

const { data: videos } = await supabaseAdmin
  .from('video_ads')
  .select('*')
  .order('display_order', { ascending: true })
  .order('created_at', { ascending: false });

const allVideos = videos ?? [];

const { count: totalVideos } = await supabaseAdmin
  .from('video_ads').select('*', { count: 'exact', head: true });

const { count: activeVideos } = await supabaseAdmin
  .from('video_ads').select('*', { count: 'exact', head: true })
  .eq('is_active', true);

const categories = [...new Set(allVideos.map((v) => v.category).filter(Boolean))];
---

<AdminLayout title="Video Iklan — Batavia 17" activeMenu="video-ads" userRole="admin_utama" userEmail={user.email ?? ''}>
  <div class="p-4 sm:p-6 lg:p-8">

    {/* Page header */}
    <div class="mb-6 flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
      <div>
        <h1 class="text-xl sm:text-2xl font-bold text-slate-900">Video Iklan</h1>
        <p class="text-slate-500 text-sm mt-0.5">Kelola video, caption, dan hashtag untuk media sosial.</p>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <button id="btn-open-sync" class="flex items-center justify-center gap-2 bg-[#0A1931] hover:bg-[#1a3a5c] text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-colors">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          Sync Sheet
        </button>
      </div>
    </div>

    {/* Stats */}
    <div class="grid grid-cols-3 gap-3 mb-6">
      <div class="bg-white rounded-xl p-4 border border-slate-200">
        <div class="text-[11px] sm:text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Total</div>
        <div class="text-2xl sm:text-3xl font-extrabold text-slate-900">{totalVideos ?? 0}</div>
      </div>
      <div class="bg-white rounded-xl p-4 border border-slate-200">
        <div class="text-[11px] sm:text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Aktif</div>
        <div class="text-2xl sm:text-3xl font-extrabold text-green-600">{activeVideos ?? 0}</div>
      </div>
      <div class="bg-white rounded-xl p-4 border border-slate-200">
        <div class="text-[11px] sm:text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Kategori</div>
        <div class="text-2xl sm:text-3xl font-extrabold text-[#0A1931]">{categories.length}</div>
      </div>
    </div>

    {/* Auto-sync status bar */}
    <div id="auto-sync-bar" class={`mb-4 flex items-center gap-2.5 text-xs px-3 py-2 rounded-lg ${hasAutoSyncConfig ? 'bg-green-50 text-green-700 border border-green-200' : 'bg-amber-50 text-amber-700 border border-amber-200'}`}>
      <span id="auto-sync-icon">
        {hasAutoSyncConfig
          ? <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          : <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        }
      </span>
      <span id="auto-sync-label">{hasAutoSyncConfig ? `Auto-sync aktif — Sheet: "${sheetName}"` : 'Auto-sync belum dikonfigurasi. Isi Spreadsheet ID & Sheet Name lalu Sync.'}</span>
    </div>

    {/* Sync panel */}
    <div id="sync-panel" class="hidden bg-gradient-to-br from-[#0A1931] to-[#1a3a5c] rounded-2xl p-5 sm:p-6 mb-6 text-white">
      <div class="flex items-start justify-between mb-4">
        <div>
          <h2 class="text-base sm:text-lg font-bold">Sync dari Google Sheets</h2>
          <p class="text-white/60 text-xs mt-0.5">Ambil video, caption, dan hashtag dari spreadsheet.</p>
        </div>
        <button id="btn-close-sync" class="text-white/50 hover:text-white transition-colors p-1">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
        <div>
          <label class="block text-white/80 text-xs font-medium mb-1.5">Spreadsheet ID</label>
          <input type="text" id="sync-spreadsheet-id" placeholder="1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74" value={spreadsheetId}
            class="w-full px-3 py-2.5 rounded-lg bg-white/10 border border-white/20 text-white placeholder-white/40 text-sm focus:outline-none focus:ring-2 focus:ring-[#D4AF37]/50 focus:border-[#D4AF37]/50" />
        </div>
        <div>
          <label class="block text-white/80 text-xs font-medium mb-1.5">Sheet Name</label>
          <input type="text" id="sync-sheet-name" placeholder="Videos" value={sheetName}
            class="w-full px-3 py-2.5 rounded-lg bg-white/10 border border-white/20 text-white placeholder-white/40 text-sm focus:outline-none focus:ring-2 focus:ring-[#D4AF37]/50 focus:border-[#D4AF37]/50" />
        </div>
      </div>
      <div class="bg-white/5 border border-white/10 rounded-lg p-3 mb-4 text-xs text-white/60">
        <p class="font-semibold text-white/80 mb-1">Kolom didukung:</p>
        <p><span class="text-[#D4AF37]">Captions</span>, <span class="text-[#D4AF37]">Hastag</span>, <span class="text-[#D4AF37]">video link</span>, <span class="text-[#D4AF37]">title</span> (opsional)</p>
      </div>
      <div id="sync-status" class="hidden text-sm mb-3 p-3 rounded-lg"></div>
      <button id="btn-do-sync" class="flex items-center gap-2 bg-[#D4AF37] hover:bg-[#c9a430] text-[#0A1931] font-bold text-sm px-5 py-2.5 rounded-xl transition-colors">
        <svg id="sync-spinner" class="hidden animate-spin" width="14" height="14" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
        <span id="sync-btn-text">Jalankan Sync</span>
      </button>
    </div>

    {/* Search & filter row */}
    <div class="flex gap-2 mb-4">
      <div class="relative flex-1 min-w-0">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="search-input" placeholder="Cari..."
          class="w-full pl-9 pr-3 py-2 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#0A1931]/20 focus:border-[#0A1931]/40 bg-white" />
      </div>
      <select id="filter-category" class="border border-slate-300 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#0A1931]/20 bg-white text-slate-600 shrink-0">
        <option value="">Semua</option>
        {categories.map(c => <option value={c}>{c}</option>)}
      </select>
      <button id="btn-add" class="flex items-center gap-1.5 bg-[#0A1931] hover:bg-[#1a3a5c] text-white text-xs sm:text-sm font-semibold px-3 sm:px-4 py-2 rounded-xl transition-colors shrink-0">
        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        <span class="hidden sm:inline">Tambah</span>
      </button>
    </div>

    {/* Video grid */}
    {allVideos.length === 0 ? (
      <div class="bg-white rounded-xl border border-slate-200 py-14 text-center">
        <div class="text-4xl mb-3">🎬</div>
        <p class="text-slate-500 font-medium">Belum ada video.</p>
        <p class="text-slate-400 text-sm mt-1">Tambah manual atau sync dari Google Sheet.</p>
      </div>
    ) : (
      <div id="video-list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {allVideos.map((v) => (
          <div class="video-card bg-white rounded-xl border border-slate-200 overflow-hidden hover:shadow-md hover:border-[#0A1931]/20 transition-all flex flex-col"
            data-title={v.title?.toLowerCase() ?? ''}
            data-caption={v.caption?.toLowerCase() ?? ''}
            data-category={v.category ?? ''}
          >
            {/* Thumbnail — click opens preview modal */}
            <button
              class="block bg-slate-900 relative shrink-0 w-full cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#D4AF37]/60"
              style="aspect-ratio: 16/9;"
              data-video-url={v.video_url ?? ''}
              data-title={v.title}
              data-id={v.id}
              aria-label={`Preview ${v.title}`}
            >
              {v.thumbnail_url ? (
                <img src={v.thumbnail_url} alt={v.title} class="w-full h-full object-cover" loading="lazy" />
              ) : (
                <div class="w-full h-full flex items-center justify-center">
                  <svg width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.5" class="text-white/30" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                </div>
              )}
              {/* Play overlay */}
              <div class="absolute inset-0 flex items-center justify-center bg-black/0 hover:bg-black/30 transition-colors">
                <div class="w-10 h-10 rounded-full bg-white/85 flex items-center justify-center">
                  <svg width="18" height="18" fill="#0A1931" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                </div>
              </div>
              {/* Status badge */}
              <div class="absolute top-2 left-2">
                {v.is_active ? (
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-green-500/90 text-white backdrop-blur-sm">
                    <span class="w-1.5 h-1.5 rounded-full bg-white"></span>Aktif
                  </span>
                ) : (
                  <span class="inline-flex px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-500/90 text-white backdrop-blur-sm">Nonaktif</span>
                )}
              </div>
            </button>

            {/* Card body */}
            <div class="p-3 flex flex-col flex-1 min-h-0">
              <div class="flex items-center gap-1.5 mb-1">
                {v.category && (
                  <span class="text-[10px] font-semibold text-[#0A1931]/60 bg-[#0A1931]/5 px-1.5 py-0.5 rounded-full shrink-0">{v.category}</span>
                )}
                <span class="text-[10px] text-slate-400 ml-auto shrink-0">#{v.display_order}</span>
              </div>
              <a href={`/admin/video-ads/${v.id}`} class="block font-semibold text-slate-900 text-sm leading-tight mb-1 hover:text-[#0A1931] transition-colors line-clamp-2">
                {v.title}
              </a>
              {v.caption && (
                <p class="text-xs text-slate-500 line-clamp-2 mb-2 flex-none">{v.caption}</p>
              )}
              {v.hashtags && v.hashtags.length > 0 && (
                <div class="flex flex-wrap gap-1 mb-2 flex-none">
                  {v.hashtags.slice(0, 3).map((tag: string) => (
                    <span class="text-[10px] text-[#D4AF37] bg-[#D4AF37]/10 border border-[#D4AF37]/20 px-1.5 py-0.5 rounded-full">#{tag}</span>
                  ))}
                  {v.hashtags.length > 3 && (
                    <span class="text-[10px] text-slate-400 self-center">+{v.hashtags.length - 3}</span>
                  )}
                </div>
              )}
              <div class="flex items-center gap-1.5 mt-auto pt-2 border-t border-slate-100">
                <button class="btn-copy-caption flex-1 flex items-center justify-center gap-1 py-1.5 rounded-lg text-[11px] font-semibold transition-colors"
                  data-caption={v.caption ?? ''} data-hashtags={JSON.stringify(v.hashtags ?? [])}
                  style="background: #D4AF3715; color: #9A7B2A;">
                  <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                  Copy
                </button>
                <a href={`/admin/video-ads/${v.id}`}
                  class="flex items-center justify-center gap-1 py-1.5 px-3 rounded-lg bg-[#0A1931] hover:bg-[#1a3a5c] text-white text-[11px] font-semibold transition-colors">
                  Detail
                  <svg width="9" height="9" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</AdminLayout>

{/* Video Preview Modal */}
<div id="preview-modal" class="hidden fixed inset-0 z-[60] flex items-center justify-center bg-black/70 p-4">
  <div class="bg-white rounded-2xl w-full max-w-2xl shadow-2xl overflow-hidden">
    <div class="px-4 py-3 bg-[#0A1931] flex items-center justify-between">
      <h3 id="preview-title" class="text-white font-semibold text-sm truncate pr-4"></h3>
      <button id="btn-close-preview" class="text-white/60 hover:text-white transition-colors shrink-0">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div id="preview-container" class="bg-black" style="aspect-ratio: 16/9;"></div>
  </div>
</div>

{/* CRUD Modal */}
<div id="modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
  <div class="bg-white rounded-2xl w-full max-w-lg shadow-2xl max-h-[90vh] overflow-y-auto">
    <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between sticky top-0 bg-white rounded-t-2xl">
      <h2 id="modal-title" class="text-base font-bold text-slate-900">Tambah Video</h2>
      <button id="btn-close-modal" class="text-slate-400 hover:text-slate-600 transition-colors">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <form id="video-form" class="p-5 space-y-4">
      <input type="hidden" id="form-id" />
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Judul <span class="text-red-500">*</span></label>
        <input type="text" id="form-title" required placeholder="Video Konsultasi Hukum Gratis"
          class="w-full px-3 py-2.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#0A1931]/30 focus:border-[#0A1931]/40" />
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Link Video (Drive)</label>
          <input type="url" id="form-video_url" placeholder="https://drive.google.com/..."
            class="w-full px-3 py-2.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#0A1931]/30 focus:border-[#0A1931]/40" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Link Thumbnail</label>
          <input type="url" id="form-thumbnail_url" placeholder="https://..."
            class="w-full px-3 py-2.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#0A1931]/30 focus:border-[#0A1931]/40" />
        </div>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Kategori</label>
          <input type="text" id="form-category" placeholder="TikTok"
            class="w-full px-3 py-2.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#0A1931]/30 focus:border-[#0A1931]/40" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Urutan</label>
          <input type="number" id="form-display_order" value="0" min="0"
            class="w-full px-3 py-2.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#0A1931]/30 focus:border-[#0A1931]/40" />
        </div>
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Caption</label>
        <textarea id="form-caption" rows="3" placeholder="Caption untuk posting..."
          class="w-full px-3 py-2.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#0A1931]/30 focus:border-[#0A1931]/40 resize-none"></textarea>
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Hashtag <span class="text-slate-400 font-normal">(pisahkan dengan koma)</span></label>
        <input type="text" id="form-hashtags" placeholder="hukum, batavia17, konsultasi"
          class="w-full px-3 py-2.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#0A1931]/30 focus:border-[#0A1931]/40" />
      </div>
      <div class="flex items-center gap-2">
        <input type="checkbox" id="form-is_active" checked class="w-4 h-4 rounded accent-[#0A1931]" />
        <label for="form-is_active" class="text-sm text-slate-700 font-medium">Video aktif</label>
      </div>
      <div id="form-status" class="hidden text-sm p-3 rounded-lg"></div>
      <div class="flex justify-end gap-3 pt-1">
        <button type="button" id="btn-cancel-form" class="px-4 py-2 text-sm text-slate-600 hover:text-slate-900 font-medium rounded-lg hover:bg-slate-100 transition-colors">Batal</button>
        <button type="submit" id="btn-submit" class="bg-[#0A1931] hover:bg-[#1a3a5c] text-white text-sm font-bold px-6 py-2.5 rounded-xl transition-colors">Simpan</button>
      </div>
    </form>
  </div>
</div>

{/* Delete confirm modal */}
<div id="delete-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4">
  <div class="bg-white rounded-xl p-5 max-w-sm w-full shadow-2xl">
    <h3 class="font-bold text-slate-900 mb-1.5">Hapus Video?</h3>
    <p class="text-sm text-slate-500 mb-4">Video "<strong id="delete-title"></strong>" akan dihapus permanen.</p>
    <div class="flex gap-3">
      <button id="btn-delete-cancel" class="flex-1 px-4 py-2 text-sm text-slate-600 hover:text-slate-900 font-medium rounded-lg hover:bg-slate-100 transition-colors">Batal</button>
      <button id="btn-delete-confirm" class="flex-1 px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-sm font-bold rounded-xl">Hapus</button>
    </div>
  </div>
</div>

{/* Toast */}
<div id="toast" class="hidden fixed bottom-4 left-1/2 -translate-x-1/2 z-[100] px-5 py-3 rounded-xl shadow-lg text-sm font-semibold text-white bg-slate-800 whitespace-nowrap"></div>

<!-- Pass server env vars to client script -->
<script define:vars={{ spreadsheetId, sheetName, hasAutoSyncConfig }}>
  window.__AUTO_SPREADSHEET_ID__ = spreadsheetId;
  window.__AUTO_SHEET_NAME__ = sheetName;
  window.__HAS_AUTO_SYNC__ = hasAutoSyncConfig;
</script>

<script>
  import { createClient } from '@supabase/supabase-js';
  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  let editingId: string | null = null;
  let deleteTargetId = '';
  let deleteTargetTitle = '';

  // --- Preview modal ---
  function parseVideoUrl(url: string | null) {
    if (!url) return { type: 'none' as const, embedUrl: null };
    const driveMatch = String(url).match(/\/file\/d\/([^/]+)\//);
    if (driveMatch) {
      return { type: 'drive' as const, embedUrl: `https://drive.google.com/file/d/${driveMatch[1]}/preview` };
    }
    if (/\.(mp4|webm|mov|avi|m4v)(\?.*)?$/i.test(url)) {
      return { type: 'direct' as const, embedUrl: url };
    }
    if (url.includes('youtube.com') || url.includes('youtu.be') || url.includes('tiktok.com')) {
      return { type: 'embed' as const, embedUrl: url };
    }
    return { type: 'local' as const, embedUrl: url };
  }

  function openPreviewModal(btn: HTMLButtonElement) {
    const url = btn.dataset.videoUrl ?? '';
    const title = btn.dataset.title ?? '';
    const titleEl = document.getElementById('preview-title')!;
    const container = document.getElementById('preview-container')!;
    titleEl.textContent = title;
    const parsed = parseVideoUrl(url);
    if (parsed.type === 'none') {
      container.innerHTML = `<div class="w-full h-full flex items-center justify-center text-white/40 text-sm">Tidak ada video URL</div>`;
    } else if (parsed.type === 'direct') {
      container.innerHTML = `<video src="${parsed.embedUrl}" controls autoplay class="w-full h-full" controlsList="nodownload"></video>`;
    } else if (parsed.type === 'drive') {
      container.innerHTML = `<iframe src="${parsed.embedUrl}" class="w-full h-full border-0" allow="autoplay; fullscreen" title="${title}"></iframe>`;
    } else if (parsed.type === 'embed') {
      container.innerHTML = `<iframe src="${parsed.embedUrl}" class="w-full h-full border-0" allow="autoplay; fullscreen" title="${title}"></iframe>`;
    } else {
      container.innerHTML = `<div class="w-full h-full flex items-center justify-center text-white/40 text-sm">Format tidak didukung</div>`;
    }
    document.getElementById('preview-modal')!.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closePreviewModal() {
    document.getElementById('preview-modal')!.classList.add('hidden');
    document.getElementById('preview-container')!.innerHTML = '';
    document.body.style.overflow = '';
  }

  document.getElementById('btn-close-preview')?.addEventListener('click', closePreviewModal);
  document.getElementById('preview-modal')?.addEventListener('click', (e) => {
    if (e.target === document.getElementById('preview-modal')) closePreviewModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closePreviewModal();
  });

  // --- Toast ---
  function showToast(msg: string, isError = false) {
    const el = document.getElementById('toast')!;
    el.textContent = msg;
    el.className = `fixed bottom-4 left-1/2 -translate-x-1/2 z-[100] px-5 py-3 rounded-xl shadow-lg text-sm font-semibold text-white whitespace-nowrap ${isError ? 'bg-red-600' : 'bg-slate-800'}`;
    el.classList.remove('hidden');
    setTimeout(() => el.classList.add('hidden'), 3000);
  }

  function parseHashtags(raw: string): string[] {
    return (raw ?? '')
      .split(/[,\s#]+/)
      .map((t: string) => t.trim().replace(/^#+/, ''))
      .filter((t: string) => t.length > 0 && t.length <= 30);
  }

  // --- Auto-sync on load ---
  const autoSyncSpreadsheetId = (window as any).__AUTO_SPREADSHEET_ID__;
  const autoSyncSheetName = (window as any).__AUTO_SHEET_NAME__;
  const hasAutoSync = !!(window as any).__HAS_AUTO_SYNC__;

  if (hasAutoSync) {
    const lastSyncRaw = localStorage.getItem('video_ads_last_sync');
    const lastSync = parseInt(lastSyncRaw ?? '0') || 0;
    const now = Date.now();
    if (now - lastSync > 3 * 60 * 1000) {
      runAutoSync();
    }
  }

  async function runAutoSync() {
    const statusEl = document.getElementById('sync-status')!;
    const labelEl = document.getElementById('auto-sync-label')!;
    const iconEl = document.getElementById('auto-sync-icon')!;
    const barEl = document.getElementById('auto-sync-bar')!;

    iconEl.innerHTML = `<svg class="animate-spin" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>`;
    labelEl.textContent = 'Menyinkronkan...';
    barEl.className = 'mb-4 flex items-center gap-2.5 text-xs px-3 py-2 rounded-lg bg-blue-50 text-blue-700 border border-blue-200';

    try {
      const res = await fetch('/api/admin-sync-videos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ spreadsheet_id: autoSyncSpreadsheetId, sheet_name: autoSyncSheetName || 'Videos' }),
      });
      const result = await res.json();
      localStorage.setItem('video_ads_last_sync', String(Date.now()));
      if (res.ok) {
        iconEl.innerHTML = `<svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>`;
        labelEl.textContent = `Terakhir sync: baru saja — ${result.synced} video`;
        barEl.className = 'mb-4 flex items-center gap-2.5 text-xs px-3 py-2 rounded-lg bg-green-50 text-green-700 border border-green-200';
        setTimeout(() => location.reload(), 1500);
      } else {
        iconEl.innerHTML = `<svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>`;
        labelEl.textContent = `Auto-sync gagal: ${(result.error ?? 'Unknown').slice(0, 60)}`;
        barEl.className = 'mb-4 flex items-center gap-2.5 text-xs px-3 py-2 rounded-lg bg-red-50 text-red-700 border border-red-200';
      }
    } catch {
      iconEl.innerHTML = `<svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>`;
      labelEl.textContent = 'Auto-sync gagal: koneksi error';
      barEl.className = 'mb-4 flex items-center gap-2.5 text-xs px-3 py-2 rounded-lg bg-red-50 text-red-700 border border-red-200';
    }
  }

  // --- CRUD ---
  function showModal(title: string) {
    document.getElementById('modal')!.classList.remove('hidden');
    (document.getElementById('modal-title') as HTMLElement).textContent = title;
    editingId = null;
    (document.getElementById('form-id') as HTMLInputElement).value = '';
    (document.getElementById('video-form') as HTMLFormElement).reset();
    (document.getElementById('form-is_active') as HTMLInputElement).checked = true;
    (document.getElementById('form-display_order') as HTMLInputElement).value = '0';
    document.getElementById('form-status')?.classList.add('hidden');
    document.body.style.overflow = 'hidden';
  }

  function openEditModal(btn: HTMLElement) {
    document.getElementById('modal')!.classList.remove('hidden');
    (document.getElementById('modal-title') as HTMLElement).textContent = 'Edit Video';
    editingId = btn.dataset.id ?? null;
    (document.getElementById('form-id') as HTMLInputElement).value = btn.dataset.id ?? '';
    (document.getElementById('form-title') as HTMLInputElement).value = btn.dataset.title ?? '';
    (document.getElementById('form-video_url') as HTMLInputElement).value = btn.dataset.video_url ?? '';
    (document.getElementById('form-thumbnail_url') as HTMLInputElement).value = btn.dataset.thumbnail_url ?? '';
    (document.getElementById('form-caption') as HTMLTextAreaElement).value = btn.dataset.caption ?? '';
    (document.getElementById('form-hashtags') as HTMLInputElement).value = JSON.parse(btn.dataset.hashtags ?? '[]').join(', ');
    (document.getElementById('form-category') as HTMLInputElement).value = btn.dataset.category ?? '';
    (document.getElementById('form-is_active') as HTMLInputElement).checked = btn.dataset.is_active === 'true';
    (document.getElementById('form-display_order') as HTMLInputElement).value = btn.dataset.display_order ?? '0';
    document.getElementById('form-status')?.classList.add('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    document.getElementById('modal')!.classList.add('hidden');
    editingId = null;
    document.body.style.overflow = '';
  }

  // Search & filter
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const filterCategory = document.getElementById('filter-category') as HTMLSelectElement;
  const cards = document.querySelectorAll('.video-card') as NodeListOf<HTMLElement>;

  function applyFilters() {
    const search = searchInput.value.toLowerCase().trim();
    const cat = filterCategory.value;
    cards.forEach(card => {
      const matchSearch = !search || (card.dataset.title ?? '').includes(search) || (card.dataset.caption ?? '').includes(search);
      const matchCat = !cat || card.dataset.category === cat;
      card.style.display = matchSearch && matchCat ? '' : 'none';
    });
  }
  searchInput?.addEventListener('input', applyFilters);
  filterCategory?.addEventListener('change', applyFilters);

  // Thumbnail → preview modal
  document.querySelectorAll('[data-video-url]').forEach(btn => {
    btn.addEventListener('click', () => openPreviewModal(btn as HTMLButtonElement));
  });

  // Modal controls
  document.getElementById('btn-add')?.addEventListener('click', () => showModal('Tambah Video'));
  document.getElementById('btn-close-modal')?.addEventListener('click', closeModal);
  document.getElementById('btn-cancel-form')?.addEventListener('click', closeModal);
  document.getElementById('modal')?.addEventListener('click', (e) => {
    if (e.target === document.getElementById('modal')) closeModal();
  });
  document.querySelectorAll('.btn-edit').forEach(btn => btn.addEventListener('click', () => openEditModal(btn as HTMLElement)));

  // Delete
  document.querySelectorAll('.btn-delete-video').forEach(btn => {
    btn.addEventListener('click', () => {
      deleteTargetId = (btn as HTMLElement).dataset.id ?? '';
      deleteTargetTitle = (btn as HTMLElement).dataset.title ?? '';
      (document.getElementById('delete-title') as HTMLElement).textContent = deleteTargetTitle;
      document.getElementById('delete-modal')!.classList.remove('hidden');
    });
  });
  document.getElementById('btn-delete-cancel')?.addEventListener('click', () => document.getElementById('delete-modal')!.classList.add('hidden'));
  document.getElementById('btn-delete-confirm')?.addEventListener('click', async () => {
    document.getElementById('delete-modal')!.classList.add('hidden');
    const res = await fetch('/api/admin-video-ads', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: deleteTargetId }) });
    if (!res.ok) { const r = await res.json(); showToast('Gagal hapus: ' + (r.error ?? ''), true); }
    else { showToast('✓ Video dihapus.'); setTimeout(() => location.reload(), 600); }
  });

  // Copy caption + hashtags
  document.querySelectorAll('.btn-copy-caption').forEach(btn => {
    btn.addEventListener('click', async () => {
      const caption = (btn as HTMLElement).dataset.caption ?? '';
      const hashtags: string[] = JSON.parse((btn as HTMLElement).dataset.hashtags ?? '[]');
      const text = caption + (hashtags.length ? '\n\n' + hashtags.map((t: string) => '#' + t).join(' ') : '');
      try { await navigator.clipboard.writeText(text); showToast('✓ Caption + hashtag disalin!'); }
      catch { showToast('Gagal menyalin.', true); }
    });
  });

  // Form submit
  document.getElementById('video-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const statusEl = document.getElementById('form-status')!;
    const submitBtn = document.getElementById('btn-submit') as HTMLButtonElement;
    const payload = {
      title: (document.getElementById('form-title') as HTMLInputElement).value.trim(),
      video_url: (document.getElementById('form-video_url') as HTMLInputElement).value.trim(),
      thumbnail_url: (document.getElementById('form-thumbnail_url') as HTMLInputElement).value.trim(),
      caption: (document.getElementById('form-caption') as HTMLTextAreaElement).value.trim(),
      hashtags: parseHashtags((document.getElementById('form-hashtags') as HTMLInputElement).value),
      category: (document.getElementById('form-category') as HTMLInputElement).value.trim() || 'TikTok',
      is_active: (document.getElementById('form-is_active') as HTMLInputElement).checked,
      display_order: parseInt((document.getElementById('form-display_order') as HTMLInputElement).value) || 0,
    };
    if (!payload.title) {
      statusEl.className = 'text-sm p-3 rounded-lg bg-red-50 text-red-600';
      statusEl.textContent = 'Judul video wajib diisi.'; statusEl.classList.remove('hidden'); return;
    }
    submitBtn.disabled = true; submitBtn.textContent = 'Menyimpan...';
    statusEl.classList.add('hidden');
    const isEdit = !!editingId;
    const method = isEdit ? 'PUT' : 'POST';
    const body: Record<string, unknown> = { ...payload };
    if (isEdit) body.id = editingId;
    const res = await fetch('/api/admin-video-ads', { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const result = await res.json();
    if (!res.ok) {
      statusEl.className = 'text-sm p-3 rounded-lg bg-red-50 text-red-600';
      statusEl.textContent = '✗ Gagal: ' + (result.error ?? 'Unknown error'); statusEl.classList.remove('hidden');
      submitBtn.disabled = false; submitBtn.textContent = 'Simpan'; return;
    }
    showToast(isEdit ? '✓ Video diperbarui.' : '✓ Video ditambahkan.');
    closeModal();
    setTimeout(() => location.reload(), 600);
  });

  // Sync panel
  document.getElementById('btn-open-sync')?.addEventListener('click', () => document.getElementById('sync-panel')?.classList.toggle('hidden'));
  document.getElementById('btn-close-sync')?.addEventListener('click', () => document.getElementById('sync-panel')?.classList.add('hidden'));
  document.getElementById('btn-do-sync')?.addEventListener('click', async () => {
    const spreadsheetId = (document.getElementById('sync-spreadsheet-id') as HTMLInputElement).value.trim();
    const sheetNameVal = (document.getElementById('sync-sheet-name') as HTMLInputElement).value.trim() || 'Videos';
    const statusEl = document.getElementById('sync-status')!;
    const spinner = document.getElementById('sync-spinner')!;
    const btn = document.getElementById('btn-do-sync') as HTMLButtonElement;
    const btnText = document.getElementById('sync-btn-text')!;
    if (!spreadsheetId) {
      statusEl.className = 'text-sm mb-3 p-3 rounded-lg bg-red-500/20 text-red-200'; statusEl.textContent = 'Spreadsheet ID wajib diisi.'; statusEl.classList.remove('hidden'); return;
    }
    btn.disabled = true; spinner.classList.remove('hidden'); btnText.textContent = ' Menyinkronkan...';
    statusEl.classList.add('hidden');
    const res = await fetch('/api/admin-sync-videos', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ spreadsheet_id: spreadsheetId, sheet_name: sheetNameVal }),
    });
    const result = await res.json();
    btn.disabled = false; spinner.classList.add('hidden'); btnText.textContent = ' Jalankan Sync';
    if (!res.ok) {
      statusEl.className = 'text-sm mb-3 p-3 rounded-lg bg-red-500/20 text-red-200';
      statusEl.textContent = '✗ Gagal: ' + (result.error ?? 'Unknown error');
    } else {
      localStorage.setItem('video_ads_last_sync', String(Date.now()));
      statusEl.className = 'text-sm mb-3 p-3 rounded-lg bg-green-500/20 text-green-200';
      statusEl.textContent = `✓ ${result.message ?? `Berhasil sync ${result.synced} video.`}`;
      setTimeout(() => location.reload(), 1500);
    }
    statusEl.classList.remove('hidden');
  });
</script>
