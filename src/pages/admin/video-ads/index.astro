---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { supabase, supabaseAdmin } from '../../../utils/supabase';

export const prerender = false;

const accessToken = Astro.cookies.get('sb-access-token')?.value;
if (!accessToken) return Astro.redirect('/admin/login?error=required');

const { data: { user } } = await supabase.auth.getUser(accessToken);
if (!user) {
  Astro.cookies.delete('sb-access-token', { path: '/' });
  Astro.cookies.delete('sb-refresh-token', { path: '/' });
  return Astro.redirect('/admin/login?error=required');
}

const { data: profile } = await supabase
  .from('profiles').select('role').eq('id', user.id).single();

const role = (profile?.role as 'admin_utama' | 'staff') ?? 'staff';
if (role !== 'admin_utama') return Astro.redirect('/admin');

const { data: videos } = await supabaseAdmin
  .from('video_ads')
  .select('*')
  .order('display_order', { ascending: true })
  .order('created_at', { ascending: false });

const allVideos = videos ?? [];

const { count: totalVideos } = await supabaseAdmin
  .from('video_ads').select('*', { count: 'exact', head: true });

const { count: activeVideos } = await supabaseAdmin
  .from('video_ads').select('*', { count: 'exact', head: true })
  .eq('is_active', true);

const categories = [...new Set(allVideos.map((v) => v.category).filter(Boolean))];
---

<AdminLayout title="Video Iklan — Batavia 17" activeMenu="video-ads" userRole="admin_utama" userEmail={user.email ?? ''}>
  <div class="p-8">

    {/* Page header */}
    <div class="mb-8 flex items-start justify-between">
      <div>
        <h1 class="text-2xl font-bold text-slate-900">Video Iklan</h1>
        <p class="text-slate-500 text-sm mt-1">Kelola video, caption, dan hashtag untuk media sosial.</p>
      </div>
      <button id="btn-open-sync" class="flex items-center gap-2 bg-[#0A1931] hover:bg-[#1a3a5c] text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-colors">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
        Sync dari Google Sheet
      </button>
    </div>

    {/* Stats */}
    <div class="grid grid-cols-3 gap-4 mb-8">
      <div class="bg-white rounded-xl p-5 border border-slate-200">
        <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Total Video</div>
        <div class="text-3xl font-extrabold text-slate-900">{totalVideos ?? 0}</div>
      </div>
      <div class="bg-white rounded-xl p-5 border border-slate-200">
        <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Aktif</div>
        <div class="text-3xl font-extrabold text-green-600">{activeVideos ?? 0}</div>
      </div>
      <div class="bg-white rounded-xl p-5 border border-slate-200">
        <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Kategori</div>
        <div class="text-3xl font-extrabold text-[#0A1931]">{categories.length}</div>
      </div>
    </div>

    {/* Sync panel */}
    <div id="sync-panel" class="hidden bg-gradient-to-br from-[#0A1931] to-[#1a3a5c] rounded-2xl p-6 mb-8 text-white">
      <div class="flex items-start justify-between mb-4">
        <div>
          <h2 class="text-lg font-bold">Sync dari Google Sheets</h2>
          <p class="text-white/60 text-xs mt-1">Ambil daftar video, caption, dan hashtag langsung dari spreadsheet.</p>
        </div>
        <button id="btn-close-sync" class="text-white/50 hover:text-white transition-colors">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
        <div>
          <label class="block text-white/80 text-xs font-medium mb-1.5">Spreadsheet ID</label>
          <input type="text" id="sync-spreadsheet-id" placeholder="1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms"
            class="w-full px-3 py-2.5 rounded-lg bg-white/10 border border-white/20 text-white placeholder-white/40 text-sm focus:outline-none focus:ring-2 focus:ring-[#D4AF37]/50 focus:border-[#D4AF37]/50" />
        </div>
        <div>
          <label class="block text-white/80 text-xs font-medium mb-1.5">Sheet Name</label>
          <input type="text" id="sync-sheet-name" placeholder="Videos"
            class="w-full px-3 py-2.5 rounded-lg bg-white/10 border border-white/20 text-white placeholder-white/40 text-sm focus:outline-none focus:ring-2 focus:ring-[#D4AF37]/50 focus:border-[#D4AF37]/50" />
        </div>
      </div>
      <div class="bg-white/5 border border-white/10 rounded-lg p-3 mb-4 text-xs text-white/60">
        <p class="font-semibold text-white/80 mb-1">Format kolom yang didukung:</p>
        <p><span class="text-[#D4AF37]">Captions</span>, <span class="text-[#D4AF37]">Hastag</span>, <span class="text-[#D4AF37]">video link</span>, <span class="text-[#D4AF37]">title</span> (opsional)</p>
        <p class="mt-1">Hashtag pisahkan dengan spasi atau koma. <span class="text-white/80">Judul auto-generate dari URL video.</span></p>
      </div>
      <div id="sync-status" class="hidden text-sm mb-3 p-3 rounded-lg"></div>
      <button id="btn-do-sync" class="flex items-center gap-2 bg-[#D4AF37] hover:bg-[#c9a430] text-[#0A1931] font-bold text-sm px-5 py-2.5 rounded-lg transition-colors">
        <svg id="sync-spinner" class="hidden animate-spin" width="14" height="14" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
        Jalankan Sync
      </button>
    </div>

    {/* Search & filter */}
    <div class="flex gap-3 mb-4">
      <div class="relative flex-1">
        <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="search-input" placeholder="Cari judul atau caption..."
          class="w-full pl-10 pr-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#0A1931]/20 focus:border-[#0A1931]/40 bg-white" />
      </div>
      <select id="filter-category" class="border border-slate-300 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#0A1931]/20 bg-white text-slate-600">
        <option value="">Semua Kategori</option>
        {categories.map(c => <option value={c}>{c}</option>)}
      </select>
      <button id="btn-add" class="flex items-center gap-2 bg-[#0A1931] hover:bg-[#1a3a5c] text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-colors whitespace-nowrap">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Tambah Video
      </button>
    </div>

    {/* Video list */}
    <div id="video-list" class="space-y-3">
      {allVideos.length === 0 ? (
        <div class="bg-white rounded-xl border border-slate-200 py-16 text-center">
          <div class="text-4xl mb-3">🎬</div>
          <p class="text-slate-500 font-medium">Belum ada video.</p>
          <p class="text-slate-400 text-sm mt-1">Tambah manual atau sync dari Google Sheet.</p>
        </div>
      ) : (
        allVideos.map((v) => (
          <div class="video-card bg-white rounded-xl border border-slate-200 p-5 hover:shadow-sm transition-shadow"
            data-title={v.title?.toLowerCase() ?? ''}
            data-caption={v.caption?.toLowerCase() ?? ''}
            data-category={v.category ?? ''}
          >
            <div class="flex gap-4">
              {/* Thumbnail */}
              <div class="flex-shrink-0">
                {v.thumbnail_url ? (
                  <img src={v.thumbnail_url} alt={v.title} class="w-24 h-16 object-cover rounded-lg bg-slate-100" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                ) : null}
                <div class={`w-24 h-16 rounded-lg bg-slate-100 flex items-center justify-center text-slate-400 ${v.thumbnail_url ? 'hidden' : ''}`}>
                  <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                </div>
              </div>

              {/* Info */}
              <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <div class="flex items-center gap-2 mb-1">
                      <h3 class="font-semibold text-slate-900 truncate">{v.title}</h3>
                      {v.is_active ? (
                        <span class="flex-shrink-0 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-700 border border-green-200">Aktif</span>
                      ) : (
                        <span class="flex-shrink-0 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-500 border border-slate-200">Nonaktif</span>
                      )}
                    </div>
                    {v.category && (
                      <span class="inline-block text-xs text-[#0A1931]/60 bg-[#0A1931]/5 px-2 py-0.5 rounded-full mb-1.5">{v.category}</span>
                    )}
                    {v.caption && (
                      <p class="text-sm text-slate-500 line-clamp-2 mt-1">{v.caption}</p>
                    )}
                    {v.hashtags && v.hashtags.length > 0 && (
                      <div class="flex flex-wrap gap-1 mt-2">
                        {v.hashtags.slice(0, 6).map((tag: string) => (
                          <span class="text-xs text-[#D4AF37] bg-[#D4AF37]/10 px-1.5 py-0.5 rounded-full border border-[#D4AF37]/20">#{tag}</span>
                        ))}
                        {v.hashtags.length > 6 && (
                          <span class="text-xs text-slate-400">+{v.hashtags.length - 6} lagi</span>
                        )}
                      </div>
                    )}
                  </div>

                  {/* Actions */}
                  <div class="flex flex-col items-end gap-2 flex-shrink-0">
                    <div class="flex items-center gap-2">
                      <button class="btn-copy btn-copy-caption text-xs text-slate-500 hover:text-[#D4AF37] font-medium transition-colors"
                        data-caption={v.caption ?? ''} data-hashtags={JSON.stringify(v.hashtags ?? [])} title="Copy caption + hashtag">
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                        Copy
                      </button>
                      {v.video_url && (
                        <a href={v.video_url} target="_blank" rel="noopener noreferrer"
                          class="text-xs text-slate-500 hover:text-[#0A1931] font-medium transition-colors" title="Buka video">
                          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                        </a>
                      )}
                      <button class="btn-edit text-xs text-slate-500 hover:text-[#0A1931] font-medium transition-colors"
                        data-id={v.id} data-title={v.title} data-video_url={v.video_url ?? ''}
                        data-thumbnail_url={v.thumbnail_url ?? ''} data-caption={v.caption ?? ''}
                        data-hashtags={JSON.stringify(v.hashtags ?? [])}
                        data-category={v.category ?? ''} data-is_active={String(v.is_active)}
                        data-display_order={v.display_order ?? 0} title="Edit">
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                      </button>
                      <button class="btn-delete-video text-xs text-slate-400 hover:text-red-600 font-medium transition-colors"
                        data-id={v.id} data-title={v.title} title="Hapus">
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                      </button>
                    </div>
                    {v.synced_at && (
                      <span class="text-[10px] text-slate-400">Synced: {new Date(v.synced_at).toLocaleDateString('id-ID')}</span>
                    )}
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))
      )}
    </div>
  </div>
</AdminLayout>

{/* Modal */}
<div id="modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
  <div class="bg-white rounded-2xl w-full max-w-lg shadow-2xl max-h-[90vh] overflow-y-auto">
    <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between sticky top-0 bg-white rounded-t-2xl">
      <h2 id="modal-title" class="text-lg font-bold text-slate-900">Tambah Video</h2>
      <button id="btn-close-modal" class="text-slate-400 hover:text-slate-600 transition-colors">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <form id="video-form" class="px-6 py-5 space-y-4">
      <input type="hidden" id="form-id" />

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Judul <span class="text-red-500">*</span></label>
        <input type="text" id="form-title" required placeholder="Video Konsultasi Hukum Gratis"
          class="w-full px-3 py-2.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#0A1931]/30 focus:border-[#0A1931]/40" />
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Link Video (Google Drive)</label>
          <input type="url" id="form-video_url" placeholder="https://drive.google.com/..."
            class="w-full px-3 py-2.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#0A1931]/30 focus:border-[#0A1931]/40" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Link Thumbnail</label>
          <input type="url" id="form-thumbnail_url" placeholder="https://..."
            class="w-full px-3 py-2.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#0A1931]/30 focus:border-[#0A1931]/40" />
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Kategori</label>
          <input type="text" id="form-category" placeholder="general"
            class="w-full px-3 py-2.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#0A1931]/30 focus:border-[#0A1931]/40" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Urutan Tampil</label>
          <input type="number" id="form-display_order" value="0" min="0"
            class="w-full px-3 py-2.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#0A1931]/30 focus:border-[#0A1931]/40" />
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Caption</label>
        <textarea id="form-caption" rows="3" placeholder="Caption untuk posting media sosial..."
          class="w-full px-3 py-2.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#0A1931]/30 focus:border-[#0A1931]/40 resize-none"></textarea>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Hashtag <span class="text-slate-400 font-normal">(pisahkan dengan koma)</span></label>
        <input type="text" id="form-hashtags" placeholder="batavia17, hukum, konsultasi"
          class="w-full px-3 py-2.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#0A1931]/30 focus:border-[#0A1931]/40" />
      </div>

      <div class="flex items-center gap-2">
        <input type="checkbox" id="form-is_active" checked class="w-4 h-4 rounded accent-[#0A1931]" />
        <label for="form-is_active" class="text-sm text-slate-700 font-medium">Video aktif</label>
      </div>

      <div id="form-status" class="hidden text-sm p-3 rounded-lg"></div>

      <div class="flex justify-end gap-3 pt-2">
        <button type="button" id="btn-cancel-form" class="px-4 py-2 text-sm text-slate-600 hover:text-slate-900 font-medium rounded-lg hover:bg-slate-100 transition-colors">Batal</button>
        <button type="submit" id="btn-submit" class="bg-[#0A1931] hover:bg-[#1a3a5c] text-white text-sm font-bold px-6 py-2.5 rounded-xl transition-colors">Simpan</button>
      </div>
    </form>
  </div>
</div>

{/* Delete confirm modal */}
<div id="delete-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40">
  <div class="bg-white rounded-xl p-6 max-w-sm w-full mx-4 shadow-2xl">
    <h3 class="font-semibold text-slate-900 mb-2">Hapus Video?</h3>
    <p class="text-sm text-slate-600 mb-5">Video "<strong id="delete-title"></strong>" akan dihapus permanen.</p>
    <div class="flex justify-end gap-3">
      <button id="btn-delete-cancel" class="px-4 py-2 text-sm text-slate-600 hover:text-slate-900 font-medium">Batal</button>
      <button id="btn-delete-confirm" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-sm font-semibold rounded-lg">Hapus</button>
    </div>
  </div>
</div>

{/* Toast */}
<div id="toast" class="hidden fixed bottom-6 right-6 z-[100] px-4 py-3 rounded-xl shadow-lg text-sm font-medium text-white bg-slate-800"></div>

<script>
  import { createClient } from '@supabase/supabase-js';
  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  // --- State ---
  let editingId: string | null = null;
  let deleteTargetId = '';
  let deleteTargetTitle = '';

  // --- Helpers ---
  function showToast(msg: string, isError = false) {
    const el = document.getElementById('toast')!;
    el.textContent = msg;
    el.className = `fixed bottom-6 right-6 z-[100] px-4 py-3 rounded-xl shadow-lg text-sm font-medium text-white ${isError ? 'bg-red-600' : 'bg-slate-800'}`;
    el.classList.remove('hidden');
    setTimeout(() => el.classList.add('hidden'), 3000);
  }

  function parseHashtags(raw: string): string[] {
    return (raw ?? '')
      .split(/[,\s#]+/)
      .map((t: string) => t.trim().replace(/^#/, ''))
      .filter((t: string) => t.length > 0 && t.length <= 30);
  }

  function showModal(title: string) {
    const modal = document.getElementById('modal')!;
    (document.getElementById('modal-title') as HTMLElement).textContent = title;
    modal.classList.remove('hidden');
    editingId = null;
    (document.getElementById('form-id') as HTMLInputElement).value = '';
    (document.getElementById('video-form') as HTMLFormElement).reset();
    (document.getElementById('form-is_active') as HTMLInputElement).checked = true;
    (document.getElementById('form-display_order') as HTMLInputElement).value = '0';
    document.getElementById('form-status')?.classList.add('hidden');
  }

  function openEditModal(btn: HTMLElement) {
    const modal = document.getElementById('modal')!;
    (document.getElementById('modal-title') as HTMLElement).textContent = 'Edit Video';
    modal.classList.remove('hidden');
    editingId = btn.dataset.id ?? null;

    (document.getElementById('form-id') as HTMLInputElement).value = btn.dataset.id ?? '';
    (document.getElementById('form-title') as HTMLInputElement).value = btn.dataset.title ?? '';
    (document.getElementById('form-video_url') as HTMLInputElement).value = btn.dataset.video_url ?? '';
    (document.getElementById('form-thumbnail_url') as HTMLInputElement).value = btn.dataset.thumbnail_url ?? '';
    (document.getElementById('form-caption') as HTMLTextAreaElement).value = btn.dataset.caption ?? '';
    (document.getElementById('form-hashtags') as HTMLInputElement).value = JSON.parse(btn.dataset.hashtags ?? '[]').join(', ');
    (document.getElementById('form-category') as HTMLInputElement).value = btn.dataset.category ?? '';
    (document.getElementById('form-is_active') as HTMLInputElement).checked = btn.dataset.is_active === 'true';
    (document.getElementById('form-display_order') as HTMLInputElement).value = btn.dataset.display_order ?? '0';
    document.getElementById('form-status')?.classList.add('hidden');
  }

  function closeModal() {
    document.getElementById('modal')!.classList.add('hidden');
    editingId = null;
  }

  // --- Search & filter ---
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const filterCategory = document.getElementById('filter-category') as HTMLSelectElement;
  const cards = document.querySelectorAll('.video-card') as NodeListOf<HTMLElement>;

  function applyFilters() {
    const search = searchInput.value.toLowerCase().trim();
    const cat = filterCategory.value;
    cards.forEach(card => {
      const matchSearch = !search ||
        (card.dataset.title ?? '').includes(search) ||
        (card.dataset.caption ?? '').includes(search);
      const matchCat = !cat || card.dataset.category === cat;
      card.style.display = matchSearch && matchCat ? '' : 'none';
    });
  }

  searchInput?.addEventListener('input', applyFilters);
  filterCategory?.addEventListener('change', applyFilters);

  // --- Add button ---
  document.getElementById('btn-add')?.addEventListener('click', () => showModal('Tambah Video'));
  document.getElementById('btn-close-modal')?.addEventListener('click', closeModal);
  document.getElementById('btn-cancel-form')?.addEventListener('click', closeModal);
  document.getElementById('modal')?.addEventListener('click', (e) => {
    if (e.target === document.getElementById('modal')) closeModal();
  });

  // --- Form submit ---
  document.getElementById('video-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const statusEl = document.getElementById('form-status')!;
    const submitBtn = document.getElementById('btn-submit') as HTMLButtonElement;

    const payload = {
      title: (document.getElementById('form-title') as HTMLInputElement).value.trim(),
      video_url: (document.getElementById('form-video_url') as HTMLInputElement).value.trim(),
      thumbnail_url: (document.getElementById('form-thumbnail_url') as HTMLInputElement).value.trim(),
      caption: (document.getElementById('form-caption') as HTMLTextAreaElement).value.trim(),
      hashtags: parseHashtags((document.getElementById('form-hashtags') as HTMLInputElement).value),
      category: (document.getElementById('form-category') as HTMLInputElement).value.trim() || 'general',
      is_active: (document.getElementById('form-is_active') as HTMLInputElement).checked,
      display_order: parseInt((document.getElementById('form-display_order') as HTMLInputElement).value) || 0,
    };

    if (!payload.title) {
      statusEl.className = 'text-sm p-3 rounded-lg bg-red-50 text-red-600';
      statusEl.textContent = 'Judul video wajib diisi.';
      statusEl.classList.remove('hidden');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Menyimpan...';
    statusEl.classList.add('hidden');

    const isEdit = !!editingId;
    const method = isEdit ? 'PUT' : 'POST';
    const body: Record<string, unknown> = { ...payload };
    if (isEdit) body.id = editingId;

    const res = await fetch('/api/admin-video-ads', { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const result = await res.json();

    if (!res.ok) {
      statusEl.className = 'text-sm p-3 rounded-lg bg-red-50 text-red-600';
      statusEl.textContent = '✗ Gagal: ' + (result.error ?? 'Unknown error');
      statusEl.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Simpan';
      return;
    }

    showToast(isEdit ? '✓ Video berhasil diperbarui.' : '✓ Video berhasil ditambahkan.');
    closeModal();
    setTimeout(() => location.reload(), 600);
  });

  // --- Edit buttons ---
  document.querySelectorAll('.btn-edit').forEach(btn => {
    btn.addEventListener('click', () => openEditModal(btn as HTMLElement));
  });

  // --- Delete ---
  document.querySelectorAll('.btn-delete-video').forEach(btn => {
    btn.addEventListener('click', () => {
      deleteTargetId = (btn as HTMLElement).dataset.id ?? '';
      deleteTargetTitle = (btn as HTMLElement).dataset.title ?? '';
      (document.getElementById('delete-title') as HTMLElement).textContent = deleteTargetTitle;
      document.getElementById('delete-modal')!.classList.remove('hidden');
    });
  });

  document.getElementById('btn-delete-cancel')?.addEventListener('click', () => {
    document.getElementById('delete-modal')!.classList.add('hidden');
  });

  document.getElementById('btn-delete-confirm')?.addEventListener('click', async () => {
    document.getElementById('delete-modal')!.classList.add('hidden');
    const res = await fetch('/api/admin-video-ads', {
      method: 'DELETE', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: deleteTargetId }),
    });
    if (!res.ok) {
      const result = await res.json();
      showToast('Gagal hapus: ' + (result.error ?? ''), true);
    } else {
      showToast('✓ Video berhasil dihapus.');
      setTimeout(() => location.reload(), 600);
    }
  });

  // --- Copy caption + hashtags ---
  document.querySelectorAll('.btn-copy-caption').forEach(btn => {
    btn.addEventListener('click', async () => {
      const caption = (btn as HTMLElement).dataset.caption ?? '';
      const hashtags: string[] = JSON.parse((btn as HTMLElement).dataset.hashtags ?? '[]');
      const text = caption + (hashtags.length ? '\n\n' + hashtags.map((t: string) => '#' + t).join(' ') : '');
      try {
        await navigator.clipboard.writeText(text);
        showToast('✓ Caption + hashtag berhasil disalin!');
      } catch {
        showToast('Gagal menyalin ke clipboard.', true);
      }
    });
  });

  // --- Sync panel ---
  document.getElementById('btn-open-sync')?.addEventListener('click', () => {
    document.getElementById('sync-panel')?.classList.toggle('hidden');
  });
  document.getElementById('btn-close-sync')?.addEventListener('click', () => {
    document.getElementById('sync-panel')?.classList.add('hidden');
  });

  document.getElementById('btn-do-sync')?.addEventListener('click', async () => {
    const spreadsheetId = (document.getElementById('sync-spreadsheet-id') as HTMLInputElement).value.trim();
    const sheetName = (document.getElementById('sync-sheet-name') as HTMLInputElement).value.trim() || 'Sheet1';
    const statusEl = document.getElementById('sync-status')!;
    const spinner = document.getElementById('sync-spinner')!;
    const btn = document.getElementById('btn-do-sync') as HTMLButtonElement;

    if (!spreadsheetId) {
      statusEl.className = 'text-sm mb-3 p-3 rounded-lg bg-red-500/20 text-red-200';
      statusEl.textContent = 'Spreadsheet ID wajib diisi.';
      statusEl.classList.remove('hidden');
      return;
    }

    btn.disabled = true;
    spinner.classList.remove('hidden');
    (btn.childNodes[1] as Text).textContent = ' Menyinkronkan...';
    statusEl.classList.add('hidden');

    const res = await fetch('/api/admin-sync-videos', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ spreadsheet_id: spreadsheetId, sheet_name: sheetName }),
    });

    const result = await res.json();

    btn.disabled = false;
    spinner.classList.add('hidden');
    (btn.childNodes[1] as Text).textContent = ' Jalankan Sync';

    if (!res.ok) {
      statusEl.className = 'text-sm mb-3 p-3 rounded-lg bg-red-500/20 text-red-200';
      statusEl.textContent = '✗ Gagal: ' + (result.error ?? 'Unknown error');
    } else {
      statusEl.className = 'text-sm mb-3 p-3 rounded-lg bg-green-500/20 text-green-200';
      statusEl.textContent = `✓ ${result.message ?? `Berhasil sync ${result.synced} video.`}`;
      setTimeout(() => location.reload(), 1500);
    }
    statusEl.classList.remove('hidden');
  });
</script>
