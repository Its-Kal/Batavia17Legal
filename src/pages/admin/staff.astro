---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabase } from '../../utils/supabase';

export const prerender = false;

const accessToken = Astro.cookies.get('sb-access-token')?.value;
if (!accessToken) return Astro.redirect('/admin/login?error=required');

const { data: { user } } = await supabase.auth.getUser(accessToken);
if (!user) {
  Astro.cookies.delete('sb-access-token', { path: '/' });
  Astro.cookies.delete('sb-refresh-token', { path: '/' });
  return Astro.redirect('/admin/login?error=required');
}

const { data: profile } = await supabase
  .from('profiles').select('role').eq('id', user.id).single();

const role = (profile?.role as 'admin_utama' | 'staff') ?? 'staff';

if (role !== 'admin_utama') {
  return Astro.redirect('/admin');
}

// Fetch semua user dengan profile
const { data: profiles } = await supabase
  .from('profiles')
  .select('*')
  .order('is_active', { ascending: false })
  .order('created_at', { ascending: false });

// Stats
const activeStaff = (profiles ?? []).filter(p => p.is_active && p.role === 'staff').length;
const inactiveStaff = (profiles ?? []).filter(p => !p.is_active && p.role === 'staff').length;
const activeAdmin = (profiles ?? []).filter(p => p.is_active && p.role === 'admin_utama').length;
---

<AdminLayout title="Staff — Batavia 17" activeMenu="staff" userRole={role} userEmail={user.email ?? ''}>
  <div class="p-8">

    {/* Page header */}
    <div class="mb-8">
      <h1 class="text-2xl font-bold text-slate-900">Manajemen Staff</h1>
      <p class="text-slate-500 text-sm mt-1">Aktifkan atau nonaktifkan akun staff.</p>
    </div>

    {/* Summary cards */}
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
      <div class="bg-white rounded-xl p-5 border border-slate-200">
        <div class="flex items-center justify-between mb-2">
          <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Staff Aktif</div>
          <div class="w-8 h-8 rounded-lg bg-green-50 flex items-center justify-center">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
          </div>
        </div>
        <div class="text-3xl font-extrabold text-slate-900">{activeStaff}</div>
        <div class="text-xs text-slate-400 mt-1">akun bisa login</div>
      </div>
      <div class="bg-white rounded-xl p-5 border border-slate-200">
        <div class="flex items-center justify-between mb-2">
          <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Staff Dinonaktifkan</div>
          <div class="w-8 h-8 rounded-lg bg-red-50 flex items-center justify-center">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
          </div>
        </div>
        <div class="text-3xl font-extrabold text-slate-900">{inactiveStaff}</div>
        <div class="text-xs text-slate-400 mt-1">akun tidak bisa login</div>
      </div>
      <div class="bg-white rounded-xl p-5 border border-slate-200">
        <div class="flex items-center justify-between mb-2">
          <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Admin Aktif</div>
          <div class="w-8 h-8 rounded-lg bg-[#0A1931]/5 flex items-center justify-center">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0A1931" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
        </div>
        <div class="text-3xl font-extrabold text-slate-900">{activeAdmin}</div>
        <div class="text-xs text-slate-400 mt-1">akun admin utama</div>
      </div>
    </div>

    {/* Search */}
    <div class="relative mb-4">
      <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input
        type="text"
        id="search-input"
        placeholder="Cari nama atau email..."
        class="w-full pl-10 pr-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#0A1931]/20 focus:border-[#0A1931]/40 bg-white"
      />
    </div>

    {/* Filter tabs */}
    <div class="flex gap-2 mb-4">
      <button class="filter-tab active" data-filter="all">Semua</button>
      <button class="filter-tab" data-filter="active">Aktif</button>
      <button class="filter-tab" data-filter="inactive">Dinonaktifkan</button>
    </div>

    {/* Staff table */}
    <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
      <table class="w-full">
        <thead class="bg-slate-50 border-b border-slate-200">
          <tr>
            <th class="text-left px-6 py-3 text-xs font-semibold text-slate-600 uppercase tracking-wider">Nama</th>
            <th class="text-left px-6 py-3 text-xs font-semibold text-slate-600 uppercase tracking-wider">Email</th>
            <th class="text-left px-6 py-3 text-xs font-semibold text-slate-600 uppercase tracking-wider">Role</th>
            <th class="text-left px-6 py-3 text-xs font-semibold text-slate-600 uppercase tracking-wider">Status</th>
            <th class="text-left px-6 py-3 text-xs font-semibold text-slate-600 uppercase tracking-wider">Terdaftar</th>
            <th class="text-right px-6 py-3 text-xs font-semibold text-slate-600 uppercase tracking-wider">Aksi</th>
          </tr>
        </thead>
        <tbody id="staff-table-body" class="divide-y divide-slate-100">
          {(profiles ?? []).map((p) => (
            <tr
              class="staff-row hover:bg-slate-50/60 transition-colors"
              data-name={p.full_name?.toLowerCase() ?? ''}
              data-email={p.email?.toLowerCase() ?? ''}
              data-role={p.role}
              data-active={p.is_active ? 'active' : 'inactive'}
            >
              <td class="px-6 py-4">
                <div class="flex items-center gap-3">
                  <div class={`w-9 h-9 rounded-full flex items-center justify-center text-xs font-bold flex-shrink-0 ${
                    p.is_active
                      ? 'bg-[#0A1931] text-white'
                      : 'bg-slate-200 text-slate-500'
                  }`}>
                    {(p.full_name ?? p.email ?? '?').slice(0, 2).toUpperCase()}
                  </div>
                  <div class="font-medium text-sm text-slate-900">{p.full_name ?? '-'}</div>
                </div>
              </td>
              <td class="px-6 py-4 text-sm text-slate-600">{p.email}</td>
              <td class="px-6 py-4">
                <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold ${
                  p.role === 'admin_utama'
                    ? 'bg-[#D4AF37]/10 text-[#9A7B2A] border border-[#D4AF37]/30'
                    : 'bg-blue-50 text-blue-700 border border-blue-200'
                }`}>
                  {p.role === 'admin_utama' ? 'Admin Utama' : 'Staff'}
                </span>
              </td>
              <td class="px-6 py-4">
                <span id={`status-badge-${p.id}`} class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold ${
                  p.is_active
                    ? 'bg-green-100 text-green-700 border border-green-200'
                    : 'bg-red-50 text-red-600 border border-red-200'
                }`}>
                  {p.is_active ? (
                    <>
                      <span class="w-1.5 h-1.5 rounded-full bg-green-500 inline-block"></span>
                      Aktif
                    </>
                  ) : (
                    <>
                      <span class="w-1.5 h-1.5 rounded-full bg-red-400 inline-block"></span>
                      Dinonaktifkan
                    </>
                  )}
                </span>
              </td>
              <td class="px-6 py-4 text-xs text-slate-500">
                {new Date(p.created_at).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' })}
              </td>
              <td class="px-6 py-4 text-right">
                {p.id !== user.id ? (
                  <div class="flex items-center justify-end gap-3">
                    {p.is_active ? (
                      <button
                        class="btn-deactivate text-xs text-red-600 hover:text-red-800 font-medium transition-colors"
                        data-id={p.id}
                        data-name={p.full_name ?? p.email}
                      >
                        Nonaktifkan
                      </button>
                    ) : (
                      <button
                        class="btn-activate text-xs text-green-600 hover:text-green-800 font-medium transition-colors"
                        data-id={p.id}
                        data-name={p.full_name ?? p.email}
                      >
                        Aktifkan
                      </button>
                    )}
                  </div>
                ) : (
                  <span class="text-xs text-slate-400 italic">Anda</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>

      {/* Empty state */}
      <div id="empty-state" class="hidden py-12 text-center text-slate-400 text-sm">
        Tidak ada staff yang cocok dengan pencarian.
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const filterTabs = document.querySelectorAll('.filter-tab');
  const tableBody = document.getElementById('staff-table-body') as HTMLTableSectionElement;
  const emptyState = document.getElementById('empty-state') as HTMLDivElement;
  const rows = tableBody.querySelectorAll('tr.staff-row');

  // ---- Filter & Search ----
  let currentFilter = 'all';
  let currentSearch = '';

  function applyFilters() {
    let visibleCount = 0;
    rows.forEach(row => {
      const el = row as HTMLElement;
      const name = el.dataset.name ?? '';
      const email = el.dataset.email ?? '';
      const role = el.dataset.role ?? '';
      const active = el.dataset.active ?? '';

      const matchesSearch =
        !currentSearch ||
        name.includes(currentSearch) ||
        email.includes(currentSearch);

      const matchesFilter =
        currentFilter === 'all' ||
        (currentFilter === 'active' && active === 'active') ||
        (currentFilter === 'inactive' && active === 'inactive');

      if (matchesSearch && matchesFilter) {
        el.style.display = '';
        visibleCount++;
      } else {
        el.style.display = 'none';
      }
    });

    emptyState.classList.toggle('hidden', visibleCount > 0);
  }

  searchInput?.addEventListener('input', (e) => {
    currentSearch = (e.target as HTMLInputElement).value.toLowerCase().trim();
    applyFilters();
  });

  filterTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      filterTabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      currentFilter = (tab as HTMLElement).dataset.filter ?? 'all';
      applyFilters();
    });
  });

  // ---- Activate / Deactivate ----
  async function toggleStaff(id: string, action: 'activate' | 'deactivate') {
    const { error } = await supabase
      .from('profiles')
      .update({ is_active: action === 'activate', updated_at: new Date().toISOString() })
      .eq('id', id);

    if (error) {
      alert('Gagal mengubah status: ' + error.message);
      return;
    }
    location.reload();
  }

  document.querySelectorAll('.btn-activate').forEach(btn => {
    btn.addEventListener('click', () => {
      const el = btn as HTMLElement;
      if (confirm(`Aktifkan akun "${el.dataset.name}"? Staff akan bisa login kembali.`)) {
        toggleStaff(el.dataset.id ?? '', 'activate');
      }
    });
  });

  document.querySelectorAll('.btn-deactivate').forEach(btn => {
    btn.addEventListener('click', () => {
      const el = btn as HTMLElement;
      if (confirm(`Nonaktifkan "${el.dataset.name}"? Akun tidak akan bisa login.`)) {
        toggleStaff(el.dataset.id ?? '', 'deactivate');
      }
    });
  });
</script>

<style>
  .filter-tab {
    @apply px-4 py-1.5 rounded-full text-xs font-semibold transition-all cursor-pointer border;
    @apply text-slate-500 border-slate-200 bg-white hover:bg-slate-50;
  }
  .filter-tab.active {
    @apply bg-[#0A1931] text-white border-[#0A1931];
  }
</style>
