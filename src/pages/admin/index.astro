---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabase, supabaseAdmin } from '../../utils/supabase';

export const prerender = false;

const accessToken = Astro.cookies.get('sb-access-token')?.value;
if (!accessToken) return Astro.redirect('/admin/login?error=required');

const { data: { user } } = await supabase.auth.getUser(accessToken);
if (!user) {
  Astro.cookies.delete('sb-access-token', { path: '/' });
  Astro.cookies.delete('sb-refresh-token', { path: '/' });
  return Astro.redirect('/admin/login?error=required');
}

const { data: profile } = await supabase
  .from('profiles').select('role, is_active').eq('id', user.id).single();

// Blokir akun nonaktif
if (profile && !profile.is_active) {
  Astro.cookies.delete('sb-access-token', { path: '/' });
  Astro.cookies.delete('sb-refresh-token', { path: '/' });
  return Astro.redirect('/admin/login?error=inactive');
}

const role = (profile?.role as 'admin_utama' | 'staff') ?? 'staff';

// Stats: WhatsApp clicks
const { count: totalClicks } = await supabaseAdmin
  .from('whatsapp_clicks').select('*', { count: 'exact', head: true });

const today = new Date();
today.setHours(0, 0, 0, 0);
const { count: todayClicks } = await supabaseAdmin
  .from('whatsapp_clicks')
  .select('*', { count: 'exact', head: true })
  .gte('clicked_at', today.toISOString());

const weekAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);
const { count: weekClicks } = await supabaseAdmin
  .from('whatsapp_clicks')
  .select('*', { count: 'exact', head: true })
  .gte('clicked_at', weekAgo.toISOString());

const { count: totalUsers } = await supabaseAdmin
  .from('profiles').select('*', { count: 'exact', head: true });

const { count: staffCount } = await supabaseAdmin
  .from('profiles').select('*', { count: 'exact', head: true })
  .eq('role', 'staff');
---

<AdminLayout title="Statistik — Batavia 17" activeMenu="statistik" userRole={role} userEmail={user.email ?? ''}>
  <div class="p-8">
    {/* Page header */}
    <div class="mb-8">
      <h1 class="text-2xl font-bold text-slate-900">Statistik</h1>
      <p class="text-slate-500 text-sm mt-1">Ringkasan performa platform Batavia 17.</p>
    </div>

    {/* WhatsApp clicks hero card */}
    <div class="bg-gradient-to-br from-[#0A1931] to-[#1a3a5c] rounded-2xl p-8 text-white mb-8">
      <div class="flex items-start justify-between">
        <div>
          <div class="text-white/60 text-xs font-semibold uppercase tracking-wider mb-1">Total Klik WhatsApp</div>
          <div class="text-5xl font-extrabold tracking-tight">{totalClicks ?? 0}</div>
          <div class="text-white/50 text-sm mt-2">di seluruh halaman</div>
        </div>
        <div class="w-14 h-14 rounded-xl bg-white/10 flex items-center justify-center">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" class="text-[#25D366]">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
        </div>
      </div>
    </div>

    {/* Mini stats */}
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="bg-white rounded-xl p-5 border border-slate-200">
        <div class="text-slate-500 text-xs font-medium uppercase tracking-wider mb-2">Hari ini</div>
        <div class="text-2xl font-bold text-slate-900">{todayClicks ?? 0}</div>
        <div class="text-slate-400 text-xs mt-1">klik WhatsApp</div>
      </div>
      <div class="bg-white rounded-xl p-5 border border-slate-200">
        <div class="text-slate-500 text-xs font-medium uppercase tracking-wider mb-2">7 Hari Terakhir</div>
        <div class="text-2xl font-bold text-slate-900">{weekClicks ?? 0}</div>
        <div class="text-slate-400 text-xs mt-1">klik WhatsApp</div>
      </div>
      <div class="bg-white rounded-xl p-5 border border-slate-200">
        <div class="text-slate-500 text-xs font-medium uppercase tracking-wider mb-2">Total User</div>
        <div class="text-2xl font-bold text-slate-900">{totalUsers ?? 0}</div>
        <div class="text-slate-400 text-xs mt-1">akun aktif ({staffCount ?? 0} staff)</div>
      </div>
    </div>
  </div>
</AdminLayout>
