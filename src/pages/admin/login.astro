---
import Layout from '../../layouts/Layout.astro';

const error = Astro.url.searchParams.get('error');
---

<Layout title="Admin Login — Batavia 17" isDarkHeader={true}>
  <section class="min-h-[calc(100vh-5rem)] grid place-items-center bg-gradient-to-br from-navy-dark via-navy-base to-navy-surface px-6 py-20">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <div class="inline-flex w-16 h-16 rounded-full bg-gold-primary text-navy-dark items-center justify-center mb-5">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
        </div>
        <h1 class="font-heading font-extrabold text-3xl text-white">Portal Admin</h1>
        <p class="text-white/60 mt-2 text-sm">Akses terbatas untuk mitra & staf internal</p>
      </div>

      <form id="login-form" class="bg-white rounded-2xl shadow-elevated p-8">
        {error && (
          <div class="mb-5 p-3 rounded-lg bg-crimson-light text-crimson-dark text-sm border border-crimson-primary/20">
            {error === 'invalid' ? 'Password salah. Silakan coba lagi.' : 'Silakan login terlebih dahulu.'}
          </div>
        )}

        <div class="mb-5">
          <label class="text-xs font-semibold tracking-badge uppercase text-navy-base/70 mb-2 block">Email</label>
          <input type="email" name="username" required class="form-input" placeholder="admin@batavia17.legal" autocomplete="email" />
        </div>

        <div class="mb-2">
          <label class="text-xs font-semibold tracking-badge uppercase text-navy-base/70 mb-2 block">Password</label>
          <input type="password" name="password" required class="form-input" placeholder="••••••••" autocomplete="current-password" />
        </div>

        <p class="text-xs text-navy-base/40 mt-2">Hubungi admin jika lupa kata sandi.</p>

        <button type="submit" class="btn-crimson w-full mt-6" id="submit-btn">
          Masuk Portal
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </button>

        <div id="login-status" class="hidden mt-5 p-3 rounded-lg text-sm"></div>
      </form>

      <p class="text-center text-xs text-white/40 mt-6">
        © {new Date().getFullYear()} Batavia 17. Sistem internal.
      </p>
    </div>
  </section>
</Layout>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  const form = document.getElementById('login-form') as HTMLFormElement;
  const status = document.getElementById('login-status') as HTMLDivElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const email = data.get('username');
    const password = data.get('password');

    status.classList.remove('hidden');
    status.className = 'mt-5 p-3 rounded-lg bg-navy-base/5 text-navy-base text-sm';
    status.textContent = 'Memverifikasi...';
    submitBtn.disabled = true;

    const { error } = await supabase.auth.signInWithPassword({
      email: email as string,
      password: password as string,
    });

    if (error) {
      status.className = 'mt-5 p-3 rounded-lg bg-crimson-light text-crimson-dark text-sm';
      status.textContent = '✗ ' + (error.message === 'Invalid login credentials'
        ? 'Email atau password salah'
        : error.message);
      submitBtn.disabled = false;
    } else {
      // Get session and persist to cookies for SSR auth
      const { data: { session } } = await supabase.auth.getSession();
      if (session) {
        const maxAge = 60 * 60 * 24; // 24 hours
        document.cookie = `sb-access-token=${session.access_token}; path=/; max-age=${maxAge}; SameSite=Strict`;
        document.cookie = `sb-refresh-token=${session.refresh_token}; path=/; max-age=${maxAge * 7}; SameSite=Strict`;
      }
      status.className = 'mt-5 p-3 rounded-lg bg-gold-tint text-navy-base text-sm border border-gold-primary/30';
      status.textContent = '✓ Berhasil masuk. Mengalihkan...';
      setTimeout(() => { window.location.href = '/admin'; }, 600);
    }
  });
</script>
