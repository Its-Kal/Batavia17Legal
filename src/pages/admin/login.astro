---
const error = Astro.url.searchParams.get('error');
const success = Astro.url.searchParams.get('success');
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login — Batavia 17</title>
  <link rel="icon" type="image/svg+xml" href="/images/favicon1.svg" />
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    * { font-family: 'Inter', sans-serif; }
    body { background: #061124; }
  </style>
</head>
<body class="min-h-screen flex items-center justify-center relative overflow-hidden">

  <!-- Background image dengan overlay -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/hero tentang kami.webp"
      alt=""
      aria-hidden="true"
      class="w-full h-full object-cover object-center"
    />
    <!-- Gradient overlay: gelap di bawah & kiri, transparan di atas kanan -->
    <div class="absolute inset-0 bg-gradient-to-br from-[#061124]/95 via-[#061124]/80 to-[#061124]/40"></div>
  </div>

  <!-- Decorative gold line top -->
  <div class="absolute top-0 left-0 right-0 h-[3px] bg-gradient-to-r from-transparent via-[#D4AF37] to-transparent z-10"></div>

  <!-- Login card -->
  <div class="relative z-10 w-full max-w-md mx-4">

    <!-- Logo / branding header -->
    <div class="text-center mb-8">
      <div class="flex justify-center mb-4">
        <img src="/images/logo.svg" alt="Batavia 17" class="h-16 w-auto" />
      </div>
      <div class="h-[1px] bg-white/10 w-24 mx-auto mb-5"></div>
      <h1 class="font-bold text-2xl text-white tracking-tight">Portal Admin</h1>
      <p class="text-white/50 mt-1 text-sm">Akses terbatas untuk mitra & staf internal</p>
    </div>

    <!-- Form card -->
    <div class="bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl p-8 shadow-2xl">

      <!-- Success message -->
      {success === 'logout' && (
        <div class="mb-5 p-3 rounded-lg bg-green-500/10 border border-green-500/20 text-green-300 text-sm">
          ✓ Anda telah keluar dari portal.
        </div>
      )}

      <!-- Error message -->
      {error && (
        <div class="mb-5 p-3 rounded-lg bg-red-500/10 border border-red-500/20 text-red-300 text-sm">
          {error === 'required' ? 'Silakan login terlebih dahulu.' :
           error === 'inactive' ? '✗ Akun ini telah dinonaktifkan. Hubungi admin utama.' :
           '✗ Terjadi kesalahan. Silakan coba lagi.'}
        </div>
      )}

      <form id="login-form" novalidate>
        <div class="mb-5">
          <label class="text-xs font-semibold text-white/60 uppercase tracking-wider mb-2 block">
            Email
          </label>
          <input
            type="email"
            name="username"
            required
            autocomplete="email"
            placeholder="admin@batavia17.legal"
            class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-xl text-white placeholder-white/25 text-sm focus:outline-none focus:ring-2 focus:ring-[#D4AF37]/50 focus:border-[#D4AF37]/40 transition-all"
          />
        </div>

        <div class="mb-1">
          <label class="text-xs font-semibold text-white/60 uppercase tracking-wider mb-2 block">
            Password
          </label>
          <input
            type="password"
            name="password"
            required
            autocomplete="current-password"
            placeholder="••••••••"
            class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-xl text-white placeholder-white/25 text-sm focus:outline-none focus:ring-2 focus:ring-[#D4AF37]/50 focus:border-[#D4AF37]/40 transition-all"
          />
        </div>

        <p class="text-xs text-white/25 mt-2 mb-6">Hubungi admin jika lupa kata sandi.</p>

        <button
          type="submit"
          id="submit-btn"
          class="w-full py-3 px-6 bg-[#D4AF37] hover:bg-[#c9a430] text-[#061124] font-bold text-sm rounded-xl transition-all flex items-center justify-center gap-2 active:scale-[0.98]"
        >
          <span id="btn-text">Masuk Portal</span>
          <svg id="btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          <svg id="btn-spinner" class="hidden animate-spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
        </button>

        <div id="login-status" class="hidden mt-4 p-3 rounded-xl text-sm text-center"></div>
      </form>
    </div>

    <!-- Footer -->
    <p class="text-center text-white/20 text-xs mt-6">
      © {new Date().getFullYear()} Batavia 17 — Konsultan Bantuan Hukum
    </p>
  </div>

</body>
</html>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  const form = document.getElementById('login-form') as HTMLFormElement;
  const status = document.getElementById('login-status') as HTMLDivElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text') as HTMLSpanElement;
  const btnArrow = document.getElementById('btn-arrow') as SVGElement;
  const btnSpinner = document.getElementById('btn-spinner') as SVGElement;

  function setLoading(loading: boolean) {
    submitBtn.disabled = loading;
    btnText.textContent = loading ? 'Memverifikasi...' : 'Masuk Portal';
    btnArrow.classList.toggle('hidden', loading);
    btnSpinner.classList.toggle('hidden', !loading);
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const email = data.get('username') as string;
    const password = data.get('password') as string;

    status.classList.add('hidden');
    setLoading(true);

    const { error } = await supabase.auth.signInWithPassword({ email, password });

    if (error) {
      setLoading(false);
      status.className = 'mt-4 p-3 rounded-xl text-sm text-center bg-red-500/10 border border-red-500/20 text-red-300';
      status.textContent = '✗ Email atau password salah';
      status.classList.remove('hidden');
      return;
    }

    // Check is_active
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      setLoading(false);
      status.className = 'mt-4 p-3 rounded-xl text-sm text-center bg-red-500/10 border border-red-500/20 text-red-300';
      status.textContent = '✗ Session tidak valid.';
      status.classList.remove('hidden');
      await supabase.auth.signOut();
      return;
    }

    const { data: profile } = await supabase
      .from('profiles').select('is_active').eq('id', session.user.id).single();

    if (profile && !profile.is_active) {
      setLoading(false);
      await supabase.auth.signOut();
      status.className = 'mt-4 p-3 rounded-xl text-sm text-center bg-red-500/10 border border-red-500/20 text-red-300';
      status.textContent = '✗ Akun ini telah dinonaktifkan. Hubungi admin utama.';
      status.classList.remove('hidden');
      return;
    }

    // Persist to cookies for SSR auth
    const maxAge = 60 * 60 * 24;
    document.cookie = `sb-access-token=${session.access_token}; path=/; max-age=${maxAge}; SameSite=Strict; secure`;
    document.cookie = `sb-refresh-token=${session.refresh_token}; path=/; max-age=${maxAge * 7}; SameSite=Strict; secure`;

    status.className = 'mt-4 p-3 rounded-xl text-sm text-center bg-green-500/10 border border-green-500/20 text-green-300';
    status.textContent = '✓ Berhasil masuk. Mengalihkan...';
    status.classList.remove('hidden');
    setLoading(false);
    setTimeout(() => { window.location.href = '/admin'; }, 700);
  });
</script>
