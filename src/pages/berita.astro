---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../utils/supabase';
import feedback from '../data/feedback.json';

export const prerender = false;

// Fetch published articles
const { data: articles } = await supabase
  .from('content')
  .select('*')
  .eq('type', 'article')
  .eq('status', 'published')
  .order('created_at', { ascending: false });

// Extract excerpts from body HTML
const extractExcerpt = (body: string | null, maxLen = 160) => {
  if (!body) return '';
  const text = body.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
  return text.length > maxLen ? text.slice(0, maxLen) + '…' : text;
};

const totalRating = feedback.reduce((sum, f) => sum + f.rating, 0);
const avgRating = (totalRating / feedback.length).toFixed(1);

// Map article slugs to display categories
const slugToCategory: Record<string, string> = {
  'hak-tersangka-penyidikan': 'Hukum Pidana',
  'klausul-kontrak-startup': 'Hukum Bisnis',
  'mediasi-perceraian': 'Hukum Keluarga',
  'sengketa-tanah': 'Hukum Pertanahan',
  'hak-pekerja-phk': 'Hukum Ketenagakerjaan',
  'prinsip-gcg': 'Hukum Bisnis',
  'pendirian-pt-yang-benar': 'Hukum Bisnis',
};
const categories = ['Semua', 'Hukum Pidana', 'Hukum Bisnis', 'Hukum Keluarga', 'Hukum Pertanahan', 'Hukum Ketenagakerjaan'];
---

<Layout title="Berita & Edukasi Hukum — Batavia 17">
  {/* Hero */}
  <section class="bg-navy-dark text-white pt-20 relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.05]" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 32px 32px;"></div>
    <div class="container-x relative py-20 lg:py-28">
      <span class="text-gold-accent text-sm font-semibold tracking-[0.2em] uppercase">Berita & Edukasi</span>
      <h1 class="mt-5 font-heading font-extrabold text-balance text-4xl lg:text-6xl tracking-tight max-w-3xl">
        Insight Hukum<br/>
        <span class="text-gold-accent">Untuk Keputusan Tepat.</span>
      </h1>
      <p class="mt-6 text-white/75 text-lg max-w-2xl leading-relaxed">
        Artikel, panduan, dan analisis dari tim pengacara kami. Dirancang untuk membantu Anda memahami opsi hukum secara jernih.
      </p>
    </div>
  </section>

  {/* Filter chips */}
  <section class="border-b border-slate-200 bg-white sticky top-[72px] z-10">
    <div class="container-x py-5 flex flex-wrap gap-2">
      {categories.map((cat, i) => (
        <button
          class={`filter-chip px-5 py-2 rounded-full text-sm font-semibold transition-all ${i === 0 ? 'bg-[#0A1931] text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'}`}
          data-category={cat}
        >
          {cat}
        </button>
      ))}
    </div>
  </section>

  {/* Articles grid */}
  <section class="py-20 bg-[#F8F7F4]">
    <div class="container-x">
      {articles && articles.length > 0 ? (
        <div id="articles-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
          {articles.map((a) => {
            const category = slugToCategory[a.slug] ?? 'Hukum';
            const excerpt = extractExcerpt(a.body);
            const readTime = a.body ? Math.max(3, Math.ceil(a.body.replace(/<[^>]*>/g, '').split(/\s+/).length / 200)) : 5;
            return (
              <article
                class="article-card bg-white rounded-2xl overflow-hidden shadow-card hover:shadow-elevated transition-all border border-slate-100 group"
                data-category={category}
              >
                <a href={`/berita/${a.slug}`} class="block">
                  <div class="aspect-[16/10] bg-gradient-to-br from-[#0A1931] via-[#112240] to-[#061124] relative overflow-hidden">
                    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 24px 24px;"></div>
                    <div class="absolute top-4 left-4">
                      <span class="px-3 py-1 bg-[#E6C158] text-[#0A1931] text-[10px] tracking-widest uppercase font-bold rounded-full">
                        {category}
                      </span>
                    </div>
                    <div class="absolute bottom-4 right-4">
                      <span class="text-white/60 text-xs">{readTime} menit baca</span>
                    </div>
                  </div>
                  <div class="p-7">
                    <p class="text-xs text-slate-400 tracking-wider uppercase font-semibold">
                      {new Date(a.created_at).toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' })}
                    </p>
                    <h3 class="mt-3 font-heading font-bold text-lg leading-snug text-[#0A1931] group-hover:text-[#E6C158] transition-colors">
                      {a.title}
                    </h3>
                    {excerpt && (
                      <p class="mt-3 text-sm text-slate-500 leading-relaxed line-clamp-3">
                        {excerpt}
                      </p>
                    )}
                    <div class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-[#E6C158] group-hover:text-[#B8860B] transition-colors">
                      Baca artikel
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </div>
                  </div>
                </a>
              </article>
            );
          })}
        </div>
      ) : (
        <div class="text-center py-20 text-slate-400">
          <p class="text-lg">Belum ada artikel.</p>
        </div>
      )}
    </div>
  </section>

  {/* Feedback section */}
  <section class="py-24 bg-[#0A1931] text-white">
    <div class="container-x">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 items-center mb-16">
        <div>
          <span class="text-[#E6C158] text-sm font-semibold tracking-[0.2em] uppercase">Feedback Klien</span>
          <h2 class="mt-5 font-heading font-extrabold text-4xl tracking-tight">Apa Kata Mereka?</h2>
        </div>
        <div class="lg:col-span-2 flex items-center gap-8">
          <div class="text-6xl font-heading font-extrabold text-[#E6C158]">{avgRating}</div>
          <div>
            <div class="flex gap-1 mb-2">
              {Array.from({length: 5}).map((_, i) => (
                <svg width="20" height="20" viewBox="0 0 24 24" fill={i < Math.round(parseFloat(avgRating)) ? '#D4AF37' : 'rgba(255,255,255,0.2)'}><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              ))}
            </div>
            <p class="text-white/70">Rata-rata dari {feedback.length} ulasan klien</p>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {feedback.map((fb) => (
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-[#E6C158]/40 transition-colors">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-11 h-11 rounded-full bg-gradient-to-br from-[#D4AF37] to-[#B8860B] grid place-items-center text-[#0A1931] font-heading font-bold text-sm flex-shrink-0">
                {fb.name.split(' ').map((n: string) => n[0]).slice(0, 2).join('')}
              </div>
              <div>
                <p class="font-heading font-bold text-sm">{fb.name}</p>
                <p class="text-xs text-white/50">{fb.company}</p>
              </div>
            </div>
            <div class="flex gap-1 mb-3">
              {Array.from({length: fb.rating}).map(() => (
                <svg width="12" height="12" viewBox="0 0 24 24" fill="#D4AF37"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              ))}
            </div>
            <p class="text-white/85 text-sm leading-relaxed italic">"{fb.text}"</p>
            <div class="mt-4 flex items-center justify-between">
              <span class="text-[#E6C158] text-xs font-semibold tracking-wider uppercase">{fb.service}</span>
              <span class="text-xs text-white/40">{fb.date}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  // Category filter
  document.querySelectorAll('.filter-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const cat = (chip as HTMLElement).dataset.category ?? 'Semua';

      document.querySelectorAll('.filter-chip').forEach(c => {
        c.classList.remove('bg-[#0A1931]', 'text-white');
        c.classList.add('bg-slate-100', 'text-slate-600');
      });
      chip.classList.add('bg-[#0A1931]', 'text-white');
      chip.classList.remove('bg-slate-100', 'text-slate-600');

      document.querySelectorAll('.article-card').forEach(card => {
        const el = card as HTMLElement;
        if (cat === 'Semua' || el.dataset.category === cat) {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    });
  });
</script>
