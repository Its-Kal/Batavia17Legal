---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../utils/supabase';

export const prerender = false;

const { slug } = Astro.params as { slug: string };

const { data: article } = await supabase
  .from('content')
  .select('*')
  .eq('slug', slug)
  .eq('type', 'article')
  .eq('status', 'published')
  .single();

// 404 if not found
if (!article) {
  return Astro.redirect('/berita');
}

const createdDate = new Date(article.created_at);
const formattedDate = createdDate.toLocaleDateString('id-ID', {
  day: '2-digit', month: 'long', year: 'numeric'
});
const wordCount = (article.body ?? '').replace(/<[^>]*>/g, '').split(/\s+/).filter(Boolean).length;
const readTime = Math.max(3, Math.ceil(wordCount / 200));

// Related articles (same type, exclude current)
const { data: related } = await supabase
  .from('content')
  .select('slug,title,created_at')
  .eq('type', 'article')
  .eq('status', 'published')
  .neq('slug', slug)
  .order('created_at', { ascending: false })
  .limit(3);

// Map slug to category
const slugToCategory: Record<string, string> = {
  'hak-tersangka-penyidikan': 'Hukum Pidana',
  'klausul-kontrak-startup': 'Hukum Bisnis',
  'mediasi-perceraian': 'Hukum Keluarga',
  'sengketa-tanah': 'Hukum Pertanahan',
  'hak-pekerja-phk': 'Hukum Ketenagakerjaan',
  'prinsip-gcg': 'Hukum Bisnis',
  'pendirian-pt-yang-benar': 'Hukum Bisnis',
};
const category = slugToCategory[article.slug] ?? 'Hukum';
---

<Layout title={`${article.title} — Batavia 17 Legal Advisory`}>
  {/* Nav spacer */}
  <div class="h-[72px]"></div>

  {/* Article hero */}
  <section class="bg-[#0A1931] text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 32px 32px;"></div>
    <div class="container-x relative py-16 lg:py-20 max-w-4xl">
      {/* Breadcrumb */}
      <nav class="flex items-center gap-2 text-sm text-white/50 mb-8">
        <a href="/" class="hover:text-white transition-colors">Beranda</a>
        <span>/</span>
        <a href="/berita" class="hover:text-white transition-colors">Berita & Edukasi</a>
        <span>/</span>
        <span class="text-white/80">{category}</span>
      </nav>

      <div class="flex items-center gap-3 mb-6">
        <span class="px-3 py-1 bg-[#E6C158] text-[#0A1931] text-[10px] tracking-widest uppercase font-bold rounded-full">
          {category}
        </span>
        <span class="text-white/40 text-xs">{readTime} menit baca</span>
      </div>

      <h1 class="font-heading font-extrabold text-3xl lg:text-5xl leading-tight tracking-tight text-white">
        {article.title}
      </h1>

      <div class="flex items-center gap-4 mt-8 text-sm text-white/60">
        <div class="flex items-center gap-2">
          <div class="w-9 h-9 rounded-full bg-gradient-to-br from-[#D4AF37] to-[#B8860B] grid place-items-center text-[#0A1931] font-heading font-bold text-xs flex-shrink-0">
            HW
          </div>
          <span>Adv. Dr. Hendra Wijaya & Tim</span>
        </div>
        <span>·</span>
        <time datetime={article.created_at}>{formattedDate}</time>
      </div>
    </div>
  </section>

  {/* Article body */}
  <section class="py-16 lg:py-20 bg-white">
    <div class="container-x max-w-3xl">
      <article class="prose prose-lg max-w-none
        prose-headings:font-heading prose-headings:font-extrabold prose-headings:text-[#0A1931]
        prose-p:text-slate-600 prose-p:leading-relaxed prose-p:text-base
        prose-strong:text-[#0A1931] prose-strong:font-semibold
        prose-ul:text-slate-600 prose-li:text-slate-600 prose-li:leading-relaxed
        prose-h2:mt-12 prose-h2:mb-5 prose-h2:text-2xl prose-h2:text-[#0A1931]
        prose-h2:border-b prose-h2:border-[#E6C158]/40 prose-h2:pb-3
        prose-h3:mt-8 prose-h3:mb-3 prose-h3:text-xl prose-h3:text-[#0A1931]
        prose-blockquote:border-l-[#E6C158] prose-blockquote:text-slate-500 prose-blockquote:italic
        prose-a:text-[#E6C158] prose-a:no-underline hover:prose-a:underline
        prose-code:text-[#E6C158] prose-code:bg-slate-100 prose-code:px-1 prose-code:rounded
        prose-pre:bg-[#0A1931] prose-pre:text-white"
        set:html={article.body ?? ''} />

      {/* Article footer */}
      <div class="mt-16 pt-8 border-t border-slate-200 flex flex-wrap items-center justify-between gap-4">
        <a href="/berita" class="inline-flex items-center gap-2 text-sm font-semibold text-[#0A1931] hover:text-[#E6C158] transition-colors">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          Kembali ke Berita & Edukasi
        </a>
        <div class="flex items-center gap-2">
          <span class="text-sm text-slate-400">Bagikan:</span>
          <a
            href={`https://wa.me/?text=${encodeURIComponent(article.title + ' - Batavia 17 Legal Advisory')}`}
            target="_blank"
            rel="noopener"
            class="w-9 h-9 rounded-full bg-slate-100 hover:bg-[#25D366] hover:text-white text-slate-500 grid place-items-center transition-colors"
            aria-label="Bagikan via WhatsApp"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Related articles */}
  {related && related.length > 0 && (
    <section class="py-16 bg-[#F8F7F4] border-t border-slate-200">
      <div class="container-x max-w-4xl">
        <h2 class="font-heading font-extrabold text-2xl text-[#0A1931] mb-8">Artikel Terkait</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {related.map((r) => {
            const relCat = slugToCategory[r.slug] ?? 'Hukum';
            return (
              <a href={`/berita/${r.slug}`} class="group bg-white rounded-xl p-5 shadow-card hover:shadow-elevated border border-slate-100 transition-all block">
                <span class="px-2 py-0.5 bg-[#E6C158]/10 text-[#B8860B] text-[9px] tracking-widest uppercase font-bold rounded-full">
                  {relCat}
                </span>
                <h3 class="mt-3 font-heading font-bold text-sm leading-snug text-[#0A1931] group-hover:text-[#E6C158] transition-colors line-clamp-3">
                  {r.title}
                </h3>
                <p class="mt-2 text-xs text-slate-400">
                  {new Date(r.created_at).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' })}
                </p>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  {/* CTA */}
  <section class="py-16 bg-[#0A1931] text-white text-center">
    <div class="container-x max-w-2xl">
      <p class="text-[#E6C158] text-sm font-semibold tracking-widest uppercase mb-3">Butuh Pendampingan Hukum?</p>
      <h2 class="font-heading font-extrabold text-3xl mb-4">Konsultasi dengan Tim Kami</h2>
      <p class="text-white/70 mb-8">Konsultasi awal gratis. Respons dalam 1×24 jam kerja.</p>
      <a href="/#konsultasi" class="inline-flex items-center gap-2 bg-[#E6C158] hover:bg-[#B8860B] text-[#0A1931] font-bold px-6 py-3 rounded-xl transition-all">
        Jadwalkan Konsultasi
      </a>
    </div>
  </section>
</Layout>
