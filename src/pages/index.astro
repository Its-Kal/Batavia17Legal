<script is:inline>
  let expandedCard = null;
  let currentAdvokatSlide = 0;
  let advokatInterval;
  let advokatCount = 5;

  function updateAdvokatCards() {
    const carousel = document.getElementById('advokat-carousel');
    if (!carousel) return;
    const cards = carousel.querySelectorAll('.advokat-card');
    advokatCount = cards.length;
    const isMobile = window.innerWidth < 640;
    const xStep = isMobile ? 200 : 280;
    const zStep = isMobile ? -160 : -200;
    const rotStep = isMobile ? 45 : 60;

    cards.forEach((card, i) => {
      const diff = ((i - currentAdvokatSlide) % advokatCount + advokatCount) % advokatCount;
      let xPos = 0, zPos = 0, rotY = 0, opacity = 1, scale = 1;

      if (diff === 0) {
        xPos = 0; zPos = 0; rotY = 0; opacity = 1; scale = 1;
      } else if (diff === 1) {
        xPos = xStep; zPos = zStep; rotY = -rotStep; opacity = 0.85; scale = 0.85;
      } else if (diff === 2) {
        xPos = 0; zPos = zStep * 2; rotY = 0; opacity = 0.55; scale = 0.7;
      } else if (diff === advokatCount - 1) {
        xPos = -xStep; zPos = zStep; rotY = rotStep; opacity = 0.85; scale = 0.85;
      } else if (diff === advokatCount - 2) {
        xPos = 0; zPos = zStep * 2; rotY = 0; opacity = 0.55; scale = 0.7;
      } else {
        xPos = 0; zPos = -500; rotY = 0; opacity = 0; scale = 0.5;
      }

      card.style.transform = `translateX(${xPos}px) translateZ(${zPos}px) rotateY(${rotY}deg) scale(${scale})`;
      card.style.opacity = opacity;
      let z = 1;
      if (diff === 0) z = 10;
      else if (diff === 1 || diff === advokatCount - 1) z = 5;
      else if (diff === 2 || diff === advokatCount - 2) z = 3;
      card.style.zIndex = z;
    });

    const dots = document.querySelectorAll('.advokat-dot');
    dots.forEach((dot, i) => {
      const isActive = i === currentAdvokatSlide;
      dot.style.backgroundColor = isActive ? '#E6C158' : '#cbd5e1';
      dot.style.width = isActive ? '20px' : '6px';
      dot.style.height = '6px';
    });
  }

  let resizeTimer;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(updateAdvokatCards, 100);
  });

  function startAdvokatAutoplay() {
    advokatInterval = setInterval(() => {
      currentAdvokatSlide = (currentAdvokatSlide + 1) % advokatCount;
      updateAdvokatCards();
    }, 3000);
  }

  function stopAdvokatAutoplay() {
    clearInterval(advokatInterval);
  }

  function slideAdvokat(direction) {
    stopAdvokatAutoplay();
    currentAdvokatSlide = (currentAdvokatSlide + direction + advokatCount) % advokatCount;
    updateAdvokatCards();
    startAdvokatAutoplay();
  }

  function goToAdvokat(index) {
    stopAdvokatAutoplay();
    currentAdvokatSlide = index;
    updateAdvokatCards();
    startAdvokatAutoplay();
  }

  function expandCard(el) {
    const grid = document.getElementById('services-grid');
    if (!grid) return;
    const cards = grid.querySelectorAll('.service-card');
    const idx = parseInt(el.dataset.index);
    cards.forEach((c, i) => {
      if (i === idx) {
        c.classList.add('is-expanded');
      } else {
        c.classList.add('is-hidden');
      }
    });
    expandedCard = el;
  }
  function collapseCard() {
    const grid = document.getElementById('services-grid');
    if (!grid) return;
    grid.querySelectorAll('.service-card').forEach(c => {
      c.classList.remove('is-expanded', 'is-hidden');
    });
    expandedCard = null;
  }
  document.addEventListener('click', function(e) {
    const grid = document.getElementById('services-grid');
    if (grid && !grid.contains(e.target)) {
      collapseCard();
    }
  });

  window.expandCard = expandCard;
  window.collapseCard = collapseCard;
  window.slideAdvokat = slideAdvokat;
  window.goToAdvokat = goToAdvokat;

  function showAdvokatModal(card) {
    const modal = document.getElementById('advokat-modal');
    const idx = parseInt(card.dataset.index) + 1;
    const idNum = idx.toString().padStart(4, '0');
    document.getElementById('modal-img').src = card.dataset.img;
    document.getElementById('modal-img').alt = card.dataset.name;
    document.getElementById('modal-name').textContent = card.dataset.name;
    document.getElementById('modal-role').textContent = card.dataset.role;
    document.getElementById('modal-spec').textContent = card.dataset.spec;
    document.getElementById('modal-badge').textContent = card.dataset.badge;
    document.getElementById('modal-id').textContent = idNum;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    stopAdvokatAutoplay();
  }

  function closeAdvokatModal() {
    const modal = document.getElementById('advokat-modal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    startAdvokatAutoplay();
  }

  async function downloadIdCard() {
    const cardFront = document.querySelector('.id-card-wrapper');
    const cardBack = document.querySelector('.id-card-wrapper-back');
    if (!cardFront) return;
    const downloadBtn = document.getElementById('modal-download');
    const originalHTML = downloadBtn.innerHTML;
    downloadBtn.innerHTML = 'Generating...';
    downloadBtn.disabled = true;
    downloadBtn.style.visibility = 'hidden';
    await new Promise(resolve => setTimeout(resolve, 1000));
    try {
      // @ts-ignore
      const canvas = await html2canvas(cardFront, {
        scale: 2,
        backgroundColor: '#ffffff',
        useCORS: true,
        logging: false
      });
      // @ts-ignore
      const { jsPDF } = window.jspdf;
      const pdf = new jsPDF({
        orientation: 'landscape',
        unit: 'px',
        format: [cardFront.offsetWidth, cardFront.offsetHeight]
      });
      // Page 1 - Front
      const imgData1 = canvas.toDataURL('image/jpeg', 0.95);
      pdf.addImage(imgData1, 'JPEG', 0, 0, cardFront.offsetWidth, cardFront.offsetHeight);
      // Page 2 - Back
      if (cardBack) {
        cardBack.classList.remove('hidden');
        const canvasBack = await html2canvas(cardBack, {
          scale: 2,
          backgroundColor: '#ffffff',
          useCORS: true,
          logging: false
        });
        pdf.addPage([cardBack.offsetWidth, cardBack.offsetHeight], 'landscape');
        const imgData2 = canvasBack.toDataURL('image/jpeg', 0.95);
        pdf.addImage(imgData2, 'JPEG', 0, 0, cardBack.offsetWidth, cardBack.offsetHeight);
        cardBack.classList.add('hidden');
      }
      const name = document.getElementById('modal-name').textContent.replace(/\s+/g, '_');
      pdf.save(`ID_Card_${name}.pdf`);
    } catch (err) {
      console.error('Error generating PDF:', err);
      alert('Gagal generate PDF. Coba lagi.');
    }
    downloadBtn.style.visibility = 'visible';
    downloadBtn.innerHTML = originalHTML;
    downloadBtn.disabled = false;
  }

  window.showAdvokatModal = showAdvokatModal;
  window.closeAdvokatModal = closeAdvokatModal;
  window.downloadIdCard = downloadIdCard;

  // Intake Modal Functions
  const intakeData = [
    {
      name: 'Rusli Yani',
      role: 'Founder',
      badge: 'Pendiri',
      img: '/images/staff/Rusli Yani.webp'
    },
    {
      name: 'Firman',
      role: 'Staff Legal Consultant',
      badge: 'Staff Legal',
      img: '/images/staff/firman.webp'
    },
    {
      name: 'Lita Khaileena',
      role: 'Staff Legal Consultant',
      badge: 'Staff Legal',
      img: '/images/staff/Lita khaileena.webp'
    },
    {
      name: 'Farida',
      role: 'Staff Legal Consultant',
      badge: 'Staff Legal',
      img: '/images/staff/farida.webp'
    },
    {
      name: 'Bilal Ferdiansyah',
      role: 'Staff Legal Consultant',
      badge: 'Staff Legal',
      img: '/images/staff/Bilal Ferdiansyah.webp'
    }
  ];

  function showIntakeModal(index) {
    const modal = document.getElementById('intake-modal');
    const data = intakeData[index];
    if (!data) return;

    const idNum = (index + 1).toString().padStart(4, '0');
    document.getElementById('intake-modal-img').src = data.img;
    document.getElementById('intake-modal-img').alt = data.name;
    document.getElementById('intake-modal-name').textContent = data.name;
    document.getElementById('intake-modal-role').textContent = data.role;
    document.getElementById('intake-modal-badge').textContent = data.badge;
    document.getElementById('intake-modal-id').textContent = idNum;
    document.getElementById('intake-modal-title').textContent = index === 0 ? 'Pendiri Batavia 17' : 'Staff Legal Intake';

    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  function closeIntakeModal() {
    const modal = document.getElementById('intake-modal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  async function downloadIntakeIdCard() {
    const cardFront = document.querySelector('#intake-modal .id-card-wrapper');
    if (!cardFront) return;
    const downloadBtn = document.querySelector('#intake-modal button[onclick="downloadIntakeIdCard()"]');
    if (!downloadBtn) return;
    const originalHTML = downloadBtn.innerHTML;
    downloadBtn.innerHTML = 'Generating...';
    downloadBtn.disabled = true;
    downloadBtn.style.visibility = 'hidden';
    await new Promise(resolve => setTimeout(resolve, 1000));
    try {
      // @ts-ignore
      const canvas = await html2canvas(cardFront, {
        scale: 2,
        backgroundColor: '#ffffff',
        useCORS: true,
        logging: false
      });
      // @ts-ignore
      const { jsPDF } = window.jspdf;
      const pdf = new jsPDF({
        orientation: 'landscape',
        unit: 'px',
        format: [cardFront.offsetWidth, cardFront.offsetHeight]
      });
      const imgData = canvas.toDataURL('image/jpeg', 0.95);
      pdf.addImage(imgData, 'JPEG', 0, 0, cardFront.offsetWidth, cardFront.offsetHeight);
      const name = document.getElementById('intake-modal-name').textContent.replace(/\s+/g, '_');
      pdf.save(`ID_Card_${name}.pdf`);
    } catch (err) {
      console.error('Error generating PDF:', err);
      alert('Gagal generate PDF. Coba lagi.');
    }
    downloadBtn.style.visibility = 'visible';
    downloadBtn.innerHTML = originalHTML;
    downloadBtn.disabled = false;
  }

  window.showIntakeModal = showIntakeModal;
  window.closeIntakeModal = closeIntakeModal;
  window.downloadIntakeIdCard = downloadIntakeIdCard;

  document.addEventListener('DOMContentLoaded', function() {
    updateAdvokatCards();
    startAdvokatAutoplay();
    const stage = document.querySelector('.advokat-stage');
    if (stage) {
      stage.addEventListener('mouseenter', stopAdvokatAutoplay);
      stage.addEventListener('mouseleave', startAdvokatAutoplay);
      let touchStartX = 0;
      stage.addEventListener('touchstart', (e) => {
        touchStartX = e.touches[0].clientX;
      }, { passive: true });
      stage.addEventListener('touchend', (e) => {
        const touchEndX = e.changedTouches[0].clientX;
        const dx = touchEndX - touchStartX;
        if (Math.abs(dx) > 50) {
          slideAdvokat(dx > 0 ? -1 : 1);
        }
      }, { passive: true });
    }
  });
</script>
