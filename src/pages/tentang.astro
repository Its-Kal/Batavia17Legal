---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../utils/supabase';

export const prerender = false;

// Fetch page content from Supabase
const { data: page } = await supabase
  .from('content')
  .select('*')
  .eq('slug', 'tentang-kami')
  .eq('status', 'published')
  .single();

// Fetch landing_sections for tentang-kami (hero + stats)
const { data: tentangSection } = await supabase
  .from('landing_sections')
  .select('*')
  .eq('section_key', 'tentang-kami')
  .eq('status', 'published')
  .single();

// Fetch attorneys from advokat section
const { data: advokatSection } = await supabase
  .from('landing_sections')
  .select('*')
  .eq('section_key', 'advokat')
  .single();

// Fetch staff/team from staff section
const { data: staffSection } = await supabase
  .from('landing_sections')
  .select('*')
  .eq('section_key', 'staff')
  .single();

// Stats from DB or fallback
const statsList = tentangSection?.extra?.stats ?? [
  { value: '720+', label: 'Kasus Ditangani' },
  { value: '98%', label: 'Tingkat Kepuasan' },
  { value: '18+', label: 'Tahun Pengalaman' },
  { value: '1.200+', label: 'Korban Ditolong' },
];

// Attorneys from DB or fallback
const attorneys = advokatSection?.extra?.advokats ?? [
  {
    name: 'Adv. ROSLINDAWATI, S.H.I.',
    role: 'Advokat',
    specialty: 'Hukum Perdata — Tagihan Pinjol & Kartu Kredit',
    img: '/images/advocate/ADV ROSLINDAWATI, SH.i.webp',
  },
  {
    name: 'Adv. Muhamad Nur, S.H.',
    role: 'Advokat',
    specialty: 'Hukum Perdata — Intimidasi & Somasi',
    img: '/images/advocate/ADV.Muhamad nur, SH.webp',
  },
  {
    name: 'Abdus Sholeh, S.H.',
    role: 'Pengacara',
    specialty: 'Hukum Perdata — collection & Pelecehan Data',
    img: '/images/advocate/Abdus Sholeh, S.H..webp',
  },
  {
    name: 'Ahmad Akbar, S.H.',
    role: 'Pengacara',
    specialty: 'Hukum Perdata — Pelanggaran Regulasi Pinjol',
    img: '/images/advocate/AHMAD AKBAR.webp',
  },
  {
    name: 'Fikri Abdul Ajiz, S.H.',
    role: 'Pengacara',
    specialty: 'Hukum Perdata — Restrukturisasi Tagihan',
    img: '/images/advocate/Fikri Abdul Ajiz, S.H..webp',
  },
];

// Staff from DB or fallback
const staffList = staffSection?.extra?.staff ?? [
  {
    name: 'Rusli Yani',
    role: 'Founder',
    desc: 'Pendiri Batavia 17 — Berawal dari keresahan pribadi menghadapi kompleksitas tagihan pinjol dan kartu kredit, mendirikan Batavia 17 dengan misi memberikan akses keadilan yang adil dan transparan.',
    img: '/images/staff/Rusli Yani.webp',
  },
  {
    name: 'Firman',
    role: 'Staff Legal Consultant',
    desc: 'Membantu dalam analisis perkara dan persiapan dokumen hukum untuk mendukung proses pendampingan klien.',
    img: '/images/staff/firman.webp',
  },
  {
    name: 'Lita Khaileena',
    role: 'Staff Legal Consultant',
    desc: 'Memberikan konsultasi hukum awal dan membantu verifikasi kelengkapan dokumen perkara klien.',
    img: '/images/staff/Lita khaileena.webp',
  },
  {
    name: 'Farida',
    role: 'Staff Legal Consultant',
    desc: 'Mengelola dan menyusun dokumen hukum serta memastikan kelancaran komunikasi dengan klien.',
    img: '/images/staff/farida.webp',
  },
  {
    name: 'Bilal Ferdiansyah',
    role: 'Staff Legal Consultant',
    desc: 'Berkomitmen membantu kelancaran administrasi perkara dan koordinasi dengan tim hukum.',
    img: '/images/staff/Bilal Ferdiansyah.webp',
  },
];

const heroTitle = tentangSection?.title ?? 'Tim yang Berdiri di Garis Depan Pendampingan Anda.';
const heroSubtitle = tentangSection?.subtitle ?? 'Dua dekade lebih kami mengawal masyarakat yang terlilit tagihan pinjol dan kartu kredit.';
---

<Layout title="Tentang Kami — Batavia 17 Konsultan Pinjaman Online & Kartu Kredit">
  {/*
  ================================================================
  SEO: JSON-LD tentang-kami page
  ================================================================
  */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "mainEntity": {
      "@type": "LegalService",
      "name": "Batavia 17 Legal Advisory",
      "description": "Konsultan pinjaman online dan kartu kredit. Pendampingan hukum untuk tagihan pinjol, teror debt collector, somasi, dan restrukturisasi tagihan.",
      "url": "https://batavia17.my.id",
      "telephone": "+6285828331717",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Jl. Raden Inten II No.66 RT.1/RW.7, Duren Sawit",
        "addressLocality": "Jakarta Timur",
        "addressRegion": "DKI Jakarta",
        "postalCode": "13440",
        "addressCountry": "ID"
      },
      "areaServed": "Indonesia",
      "foundingDate": "2007",
      "numberOfEmployees": "10-50",
      "serviceType": ["Pendampingan Pinjaman Online", "Hukum Perdata", "Stop Debt Collector", "Restrukturisasi Tagihan"]
    }
  })} />
  {/* Hero */}
  <section class="bg-navy-dark text-white relative overflow-hidden pt-20">
    <div class="absolute inset-0 opacity-[0.05]" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 32px 32px;"></div>
    <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/images/hero tentang kami.webp');"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#0A1931]/95 via-[#0A1931]/80 to-[#0A1931]/60"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0A1931] via-transparent to-[#0A1931]/40"></div>
    <div class="container-x relative py-20 lg:py-28">
      <span class="text-gold-accent text-sm font-semibold tracking-[0.2em] uppercase">Tentang Kami</span>
      <h1 class="mt-5 font-heading font-extrabold text-balance text-4xl lg:text-6xl tracking-tight max-w-3xl">
        {heroTitle}
      </h1>
      <p class="mt-6 text-white/75 text-lg max-w-2xl leading-relaxed">
        {heroSubtitle}
      </p>
    </div>
  </section>

  {/* About Body — from Supabase */}
  {page?.body && (
    <section class="py-20 bg-white">
      <div class="container-x max-w-3xl">
        <div class="prose prose-lg max-w-none
          prose-headings:font-heading prose-headings:font-extrabold prose-headings:text-navy-dark
          prose-p:text-navy-base/80 prose-p:leading-relaxed
          prose-strong:text-navy-dark prose-strong:font-semibold
          prose-ul:space-y-2 prose-li:text-navy-base/80
          prose-h2:mt-12 prose-h2:mb-4 prose-h2:text-2xl prose-h2:border-b prose-h2:border-gold-accent/30 prose-h2:pb-3
          prose-h3:mt-8 prose-h3:mb-3 prose-h3:text-xl"
          set:html={page.body} />
      </div>
    </section>
  )}

  {/* NARATIF: Tenang, Selalu Ada Jalan */}
  <section class="py-20 lg:py-28 bg-white">
    <div class="container-x max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <span class="inline-block text-gold-deep text-xs font-bold tracking-[0.2em] uppercase px-4 py-1.5 bg-gold-tint rounded-full mb-6">Filosofi Pendampingan</span>
        <h2 class="font-heading font-extrabold text-3xl lg:text-5xl text-navy-dark leading-tight">
          Tenang, Selalu Ada Jalan.
        </h2>
      </div>

      <div class="space-y-8">
        <p class="text-lg lg:text-xl text-navy-base/75 leading-relaxed font-light">
          Saat jeratan tagihan menumpuk, wajar jika Anda merasa cemas, bingung, dan terpojok. Anda tidak harus menanggung beban ini sendirian.
        </p>
        <p class="text-base lg:text-lg text-navy-base/70 leading-relaxed">
          Batavia 17 hadir memberikan pendampingan nyata, bukan sekadar janji muluk. Kami memahami bahwa kesulitan menghadapi pinjaman online (pinjol), tagihan kartu kredit, atau cicilan bank bukanlah sebuah akhir, melainkan situasi yang butuh strategi jalan keluar.
        </p>

        {/* 3-Step Approach */}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12">
          <div class="relative bg-gradient-to-b from-[#0A1931] to-[#061124] rounded-2xl p-8 text-center border border-white/5 shadow-xl">
            <div class="w-14 h-14 rounded-full bg-gold-accent/20 border border-gold-accent/40 flex items-center justify-center mx-auto mb-5">
              <span class="font-heading font-extrabold text-gold-accent text-xl">01</span>
            </div>
            <h3 class="font-heading font-bold text-lg text-white mb-3">Analisis Empatik</h3>
            <p class="text-sm text-slate-400 leading-relaxed">Kami membedah kapasitas finansial Anda saat ini secara objektif dan tanpa menghakimi.</p>
          </div>
          <div class="relative bg-gradient-to-b from-[#0A1931] to-[#061124] rounded-2xl p-8 text-center border border-white/5 shadow-xl">
            <div class="w-14 h-14 rounded-full bg-gold-accent/20 border border-gold-accent/40 flex items-center justify-center mx-auto mb-5">
              <span class="font-heading font-extrabold text-gold-accent text-xl">02</span>
            </div>
            <h3 class="font-heading font-bold text-lg text-white mb-3">Strategi Realistis</h3>
            <p class="text-sm text-slate-400 leading-relaxed">Kami menyusun skema pelunasan yang masuk akal dan tidak mencekik arus kas harian Anda.</p>
          </div>
          <div class="relative bg-gradient-to-b from-[#0A1931] to-[#061124] rounded-2xl p-8 text-center border border-white/5 shadow-xl">
            <div class="w-14 h-14 rounded-full bg-gold-accent/20 border border-gold-accent/40 flex items-center justify-center mx-auto mb-5">
              <span class="font-heading font-extrabold text-gold-accent text-xl">03</span>
            </div>
            <h3 class="font-heading font-bold text-lg text-white mb-3">Negosiasi Langsung</h3>
            <p class="text-sm text-slate-400 leading-relaxed">Kami maju sebagai perwakilan Anda untuk berhadapan dengan pihak kreditur secara transparan dan resmi.</p>
          </div>
        </div>

        <p class="text-base lg:text-lg text-navy-base/70 leading-relaxed mt-8">
          Fokus utama Batavia 17 bukan sekadar membereskan deretan angka. Kami bekerja untuk <strong class="text-navy-dark font-semibold">mengembalikan ketenangan hidup Anda</strong>, agar Anda punya ruang untuk kembali bernapas lega, menata pikiran, dan melangkah maju.
        </p>
      </div>
    </div>
  </section>

  {/* NILAI INTI */}
  <section class="py-16 bg-surface-light">
    <div class="container-x">
      <div class="text-center mb-10">
        <h3 class="font-heading font-extrabold text-2xl lg:text-3xl text-navy-dark">Nilai Inti Kami</h3>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 max-w-4xl mx-auto">
        <div class="bg-white rounded-xl p-6 border border-navy-base/5 shadow-sm text-center">
          <div class="w-12 h-12 rounded-xl bg-gold-tint flex items-center justify-center mx-auto mb-4">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C4941E" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h4 class="font-heading font-bold text-navy-dark mb-2">Integritas</h4>
          <p class="text-xs text-navy-base/60 leading-relaxed">Kami tidak pernah mengorbankan etika demi hasil singkat.</p>
        </div>
        <div class="bg-white rounded-xl p-6 border border-navy-base/5 shadow-sm text-center">
          <div class="w-12 h-12 rounded-xl bg-gold-tint flex items-center justify-center mx-auto mb-4">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C4941E" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <h4 class="font-heading font-bold text-navy-dark mb-2">Rahasia</h4>
          <p class="text-xs text-navy-base/60 leading-relaxed">Kerahasiaan adalah pondasi kepercayaan klien.</p>
        </div>
        <div class="bg-white rounded-xl p-6 border border-navy-base/5 shadow-sm text-center">
          <div class="w-12 h-12 rounded-xl bg-gold-tint flex items-center justify-center mx-auto mb-4">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C4941E" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </div>
          <h4 class="font-heading font-bold text-navy-dark mb-2">Keberpihakan</h4>
          <p class="text-xs text-navy-base/60 leading-relaxed">Klien kami adalah prioritas, bukan portofolio.</p>
        </div>
        <div class="bg-white rounded-xl p-6 border border-navy-base/5 shadow-sm text-center">
          <div class="w-12 h-12 rounded-xl bg-gold-tint flex items-center justify-center mx-auto mb-4">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C4941E" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
          <h4 class="font-heading font-bold text-navy-dark mb-2">Transparansi</h4>
          <p class="text-xs text-navy-base/60 leading-relaxed">Semua proses berjalan jujur dan dapat dipertanggungjawabkan.</p>
        </div>
      </div>
    </div>
  </section>

  {/* Stats */}
  <section class="py-20 bg-navy-base text-white">
    <div class="container-x grid grid-cols-2 md:grid-cols-4 gap-10 text-center">
      {statsList.map((s) => (
        <div>
          <div class="font-heading font-extrabold text-5xl text-gold-primary tracking-tight">{s.value}</div>
          <div class="text-xs tracking-badge uppercase text-white/60 mt-3">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  {/* Tim Detail */}
  <section class="py-24 bg-surface-light">
    <div class="container-x">
      <div class="max-w-2xl mb-16">
        <span class="text-gold-deep text-sm font-semibold tracking-[0.2em] uppercase">Tim Pendamping</span>
        <h2 class="mt-5 font-heading font-extrabold text-4xl lg:text-5xl tracking-tight text-navy-dark">
          Tim Advokat & Staff<br/>yang Mendampingi Anda.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {attorneys.map((atty) => (
          <article class="bg-white rounded-2xl p-8 shadow-card border border-navy-base/5 hover:border-gold-accent transition-all group">
            <div class="flex items-start gap-5">
              <div class="relative shrink-0">
                <div class="w-20 h-24 rounded-xl overflow-hidden border-2 border-white shadow-lg">
                  <img alt={atty.name} class="w-full h-full object-cover object-top" src={atty.img} />
                </div>
              </div>
              <div class="flex-1">
                <h3 class="font-heading font-bold text-xl leading-tight text-navy-dark group-hover:text-gold-deep transition-colors">{atty.name}</h3>
                <p class="text-sm font-semibold text-gold-deep mt-1">{atty.role}</p>
                <div class="mt-3 space-y-1.5 text-sm text-navy-base/70">
                  <p><span class="text-navy-base/40 font-medium">Spesialisasi:</span> {atty.specialty}</p>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* CTA */}
  <section class="py-24 bg-navy-dark text-white text-center">
    <div class="container-x max-w-3xl">
      <span class="text-gold-accent text-sm font-semibold tracking-[0.2em] uppercase flex items-center justify-center gap-2">Siap Berkonsultasi?</span>
      <h2 class="mt-5 font-heading font-extrabold text-4xl lg:text-5xl tracking-tight">
        Kami Telah Menunggu Cerita Anda.
      </h2>
      <p class="mt-5 text-white/70 text-lg">Konsultasi awal gratis. Respons dalam 1×24 jam kerja. Kerahasiaan terjamin.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="https://wa.me/6285828331717?text=Halo%20Admin%20Batavia%2017%2C%20saya%20butuh%20pendampingan%20untuk%20masalah%20tagihan%20pinjaman%20online%20%2F%20kartu%20kredit." class="inline-flex items-center gap-2 bg-red-700 hover:bg-red-800 text-white font-semibold px-6 py-3 rounded-xl transition-all" target="_blank" rel="noopener noreferrer">Jadwalkan Sekarang</a>
        <a href="/berita" class="inline-flex items-center gap-2 bg-gold-accent hover:bg-gold-dim text-navy-dark font-semibold px-6 py-3 rounded-xl transition-all">Baca Insight Hukum</a>
      </div>
    </div>
  </section>
</Layout>
