---
import Layout from '../layouts/Layout.astro';
import stats from '../data/stats.json';

// Set to true to enable maintenance mode
const MAINTENANCE_MODE = true;

const { stats: statList, attorneys } = stats;
---

<Layout title="Tentang Kami — Batavia 17 Legal Advisory">
{MAINTENANCE_MODE ? (
  <div class="min-h-screen flex items-center justify-center bg-[#061124]">
    <div class="text-center px-6 max-w-xl">
      <div class="w-24 h-24 mx-auto mb-8 rounded-full bg-gold-accent/20 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#E6C158" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
      </div>
      <h1 class="font-display font-bold text-4xl text-white mb-4">Segera Hadir</h1>
      <p class="text-slate-400 text-lg mb-8">Halaman Tentang Kami sedang dalam pengembangan. Kami sedang mempersiapkan konten terbaik untuk Anda.</p>
      <a href="/" class="inline-flex items-center gap-2 bg-gold-accent hover:bg-gold-dim text-navy-dark font-semibold px-6 py-3 rounded-xl transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
        Kembali ke Beranda
      </a>
    </div>
  </div>
) : (
  <>
  {/* Hero */}
  <section class="bg-navy-dark text-white relative overflow-hidden pt-20">
    <div class="absolute inset-0 opacity-[0.05]" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 32px 32px;"></div>
    <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/images/hero tentang kami.webp');"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#0A1931]/95 via-[#0A1931]/80 to-[#0A1931]/60"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0A1931] via-transparent to-[#0A1931]/40"></div>
    <div class="container-x relative py-20 lg:py-28">
      <span class="text-gold-accent text-sm font-semibold tracking-[0.2em] uppercase">Tentang Kami</span>
      <h1 class="mt-5 font-heading font-extrabold text-balance text-4xl lg:text-6xl tracking-tight max-w-3xl">
        Dua Dekade Menjaga<br/>
        <span class="text-gold-accent">Marga & Martabat</span> Klien Kami.
      </h1>
      <p class="mt-6 text-white/75 text-lg max-w-2xl leading-relaxed">
        Batavia 17 lahir dari visi sekelompok advokat senior yang ingin mengembalikan esensi pendampingan hukum: presisi, kerahasiaan, dan keberpihakan total kepada klien.
      </p>
    </div>
  </section>

  {/* Visi Misi */}
  <section class="py-24 bg-surface-canvas">
    <div class="container-x grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div class="bg-white p-10 rounded-2xl shadow-card border border-navy-base/5">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-12 h-12 rounded-xl bg-gold-tint text-gold-deep grid place-items-center">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/></svg>
          </div>
          <h2 class="font-heading font-extrabold text-3xl">Visi</h2>
        </div>
        <p class="text-navy-base/75 leading-relaxed text-lg">
          Menjadi firma hukum rujukan di Indonesia yang dikenal atas integritas tanpa kompromi, ketajaman strategi litigasi, dan empati mendalam terhadap setiap klien.
        </p>
      </div>

      <div class="bg-white p-10 rounded-2xl shadow-card border border-navy-base/5">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-12 h-12 rounded-xl bg-gold-tint text-gold-deep grid place-items-center">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          </div>
          <h2 class="font-heading font-extrabold text-3xl">Misi</h2>
        </div>
        <ul class="space-y-3 text-navy-base/75 leading-relaxed">
          <li class="flex gap-3">
            <span class="text-gold-deep font-bold">01.</span>
            Memberikan pendampingan hukum dengan standar etika profesi tertinggi.
          </li>
          <li class="flex gap-3">
            <span class="text-gold-deep font-bold">02.</span>
            Mengembangkan kapasitas litigasi strategis yang berorientasi hasil nyata.
          </li>
          <li class="flex gap-3">
            <span class="text-gold-deep font-bold">03.</span>
            Membangun kepercayaan jangka panjang dengan transparansi biaya & proses.
          </li>
          <li class="flex gap-3">
            <span class="text-gold-deep font-bold">04.</span>
            Mendukung akses keadilan bagi komunitas melalui pro bono terpilih.
          </li>
        </ul>
      </div>
    </div>
  </section>

  {/* Stats */}
  <section class="py-20 bg-navy-base text-white">
    <div class="container-x grid grid-cols-2 md:grid-cols-4 gap-10 text-center">
      {statList.map((s) => (
        <div>
          <div class="font-heading font-extrabold text-5xl text-gold-primary tracking-tight">{s.value}</div>
          <div class="text-xs tracking-badge uppercase text-white/60 mt-3">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  {/* Tim Detail */}
  <section class="py-24 bg-surface-canvas">
    <div class="container-x">
      <div class="max-w-2xl mb-16">
        <span class="section-eyebrow">Profil Mitra</span>
        <h2 class="mt-5 font-heading font-extrabold text-4xl lg:text-5xl tracking-tight">
          Tim Yang Akan<br/>Mendampingi Anda.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {attorneys.map((atty) => (
          <article class="bg-white rounded-2xl p-8 shadow-card border border-navy-base/5 hover:border-gold-primary transition-all group">
            <div class="flex items-start gap-5">
              <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-navy-base to-navy-surface grid place-items-center text-gold-primary font-heading font-extrabold text-3xl flex-shrink-0">
                {atty.name.split(' ').slice(2, 3)[0]?.[0] ?? 'A'}
              </div>
              <div class="flex-1">
                <h3 class="font-heading font-bold text-xl leading-tight group-hover:text-gold-deep transition-colors">{atty.name}</h3>
                <p class="text-sm font-semibold text-gold-deep mt-1">{atty.role}</p>
                <div class="mt-4 space-y-1.5 text-sm text-navy-base/70">
                  <p><span class="text-navy-base/40 font-medium">Spesialisasi:</span> {atty.specialty}</p>
                  <p><span class="text-navy-base/40 font-medium">Pengalaman:</span> {atty.experience}</p>
                  <p><span class="text-navy-base/40 font-medium">Bar:</span> <span class="tracking-badge text-xs">{atty.bar}</span></p>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* CTA */}
  <section class="py-24 bg-navy-dark text-white text-center">
    <div class="container-x max-w-3xl">
      <span class="section-eyebrow text-gold-primary justify-center">Siap Berkonsultasi?</span>
      <h2 class="mt-5 font-heading font-extrabold text-4xl lg:text-5xl tracking-tight">
        Kami Telah Menunggu Cerita Anda.
      </h2>
      <p class="mt-5 text-white/70 text-lg">Konsultasi awal gratis. Respons dalam 1×24 jam kerja. Kerahasiaan terjamin.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/#konsultasi" class="btn-crimson">Jadwalkan Sekarang</a>
        <a href="/berita" class="btn-gold">Baca Insight Hukum</a>
      </div>
    </div>
  </section>
  </>
)}
</Layout>
